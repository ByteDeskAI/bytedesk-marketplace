{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bytedesk.ai/schemas/design-system.manifest.schema.json",
  "title": "ByteDesk design kit manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "catalog",
    "providers",
    "runtimes",
    "files",
    "tokens",
    "adapters",
    "profiles",
    "assets",
    "templates",
    "skills",
    "agents",
    "mcpServers",
    "bundles"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "const": "bytedesk-design-system" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "catalog": { "$ref": "#/$defs/source" },
    "providers": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "minItems": 2 },
    "runtimes": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "minItems": 3 },
    "files": { "type": "array", "items": { "$ref": "#/$defs/file" }, "minItems": 1 },
    "tokens": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "minItems": 1 },
    "adapters": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "minItems": 3 },
    "profiles": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "minItems": 1 },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
    "templates": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "minItems": 1 },
    "skills": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "minItems": 1 },
    "skillSources": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
    "agents": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
    "mcpServers": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
    "bundles": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "minItems": 1 }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["sourcePath", "sha256"],
      "properties": {
        "sourcePath": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": true
    },
    "capability": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 },
        "files": { "type": "array", "items": { "type": "string" } },
        "dependsOn": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "file": {
      "type": "object",
      "required": ["id", "kind", "sourcePath", "deliveryPath", "sha256", "size", "distributions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 },
        "deliveryPath": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "distributions": { "type": "array", "items": { "enum": ["payload", "plugin"] }, "minItems": 1 },
        "profile": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
