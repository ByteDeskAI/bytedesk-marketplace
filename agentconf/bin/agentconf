#!/usr/bin/env node
/**
 * agentconf — capability-tested configuration for AI coding agents.
 *
 * The premise, and the reason this is not another sync tool: writing a config file is not
 * evidence that anything read it. rulesync will happily write ~/.config/goose/.goosehints;
 * `strings $(command -v goose)` contains no reference to that filename. The file exists, the
 * tool ignores it, and nothing anywhere says so.
 *
 * So every adapter here carries its own proof. A target is in one of three states, never two:
 *
 *   proven    a canary token was written to the shared source, the tool was asked for it,
 *             and the tool said it back. Dated.
 *   unproven  wired, but no canary has ever run. Reported as unproven, not as working.
 *   broken    the wiring is gone or has drifted.
 *
 * What it deliberately does NOT do:
 *   - read credential files. `~/.config/github-copilot/auth.db` is 0644 with a live -wal and
 *     its mtime moves during normal use; mode and mtime carry no login signal. Vendor
 *     diagnostics (`codex doctor`, `claude auth status`) are both more accurate and not a
 *     liability. A tool that walks $HOME opening OAuth material reads as an exfiltrator
 *     regardless of what its README says.
 *   - write config the owning tool generates. ~/.codex/rules/default.rules is appended to by
 *     Codex on every approval; editing it is fighting a generator.
 *   - reimplement rulesync. rulesync writes, agentconf proves the write was read.
 */

import { readFileSync, writeFileSync, readdirSync, existsSync, lstatSync, realpathSync, mkdirSync, mkdtempSync, rmSync, symlinkSync, unlinkSync, copyFileSync } from "node:fs";
import { join, dirname } from "node:path";
import { homedir, tmpdir } from "node:os";
import { spawnSync } from "node:child_process";
import { fileURLToPath } from "node:url";

const HOME = homedir();
const ROOT = dirname(dirname(fileURLToPath(import.meta.url)));
const SHARED_DIR = join(HOME, ".agents");
const SOURCE = join(SHARED_DIR, "AGENTS.md");

const expand = (p) => (p.startsWith("~/") ? join(HOME, p.slice(2)) : p);
const pretty = (p) => (p.startsWith(HOME) ? "~" + p.slice(HOME.length) : p);

/** Adapters are data, so adding a tool is a file plus a passing canary — not a code change. */
function adapters() {
  const dir = join(ROOT, "adapters");
  if (!existsSync(dir)) return [];
  return readdirSync(dir)
    .filter((f) => f.endsWith(".json"))
    .map((f) => JSON.parse(readFileSync(join(dir, f), "utf8")))
    .sort((a, b) => a.id.localeCompare(b.id));
}

const has = (bin) => spawnSync("command", ["-v", bin], { shell: true, encoding: "utf8" }).status === 0;

// ---------------------------------------------------------------- check (offline, fast)

/**
 * check answers "is the wiring intact?" without invoking a single model.
 *
 * This is the one that runs every session. The failure it exists to catch is silent: an
 * editor that saves atomically replaces a symlink with a regular file, no error, and the
 * files quietly fork. Six weeks later a tool has been running without your rules.
 */
function check() {
  const problems = [];
  const ok = [];

  if (!existsSync(SOURCE)) {
    problems.push(`${pretty(SOURCE)} is missing — there is no shared source to wire to`);
    return { problems, ok };
  }

  for (const a of adapters()) {
    if (a.detect?.bin && !has(a.detect.bin)) continue; // not installed here; not a problem
    const target = expand(a.target);

    if (a.mechanism === "import") {
      if (!existsSync(target)) problems.push(`${pretty(target)} is missing`);
      else if (!readFileSync(target, "utf8").split("\n").some((l) => l.trim() === a.importLine))
        problems.push(`${pretty(target)} no longer imports the shared file (expected a line: ${a.importLine})`);
      else ok.push(a.id);
    } else if (a.mechanism === "symlink") {
      if (!existsSync(target)) problems.push(`${pretty(target)} is missing`);
      else if (!lstatSync(target).isSymbolicLink())
        problems.push(`${pretty(target)} is not a symlink — an editor probably replaced it, and it has forked from the source`);
      else if (realpathSync(target) !== realpathSync(SOURCE))
        problems.push(`${pretty(target)} points somewhere other than ${pretty(SOURCE)}`);
      else ok.push(a.id);
    } else if (a.mechanism === "copy") {
      const src = expand(a.source);
      if (!existsSync(src)) problems.push(`${pretty(src)} is missing`);
      else if (existsSync(target) && lstatSync(target).isSymbolicLink())
        problems.push(`${pretty(target)} is a SYMLINK — ${a.tool} ignores those, so this policy is NOT in force. Copy it instead.`);
      else if (!existsSync(target)) problems.push(`${pretty(target)} is missing — the policy is not loaded`);
      else if (readFileSync(src, "utf8") !== readFileSync(target, "utf8"))
        problems.push(`${pretty(target)} has drifted from ${pretty(src)} — re-sync with: agentconf wire`);
      else ok.push(a.id);
    }
  }
  return { problems, ok };
}

// ---------------------------------------------------------------- detect

/**
 * detect reports what is installed and logged in, by asking each vendor's own diagnostic.
 *
 * `codex doctor` catches states a file check cannot — it reports "mixed auth signals:
 * ChatGPT login plus API key env var", which a credential-file stat() calls green.
 */
function detect() {
  const seen = new Map();
  for (const a of adapters()) {
    const bin = a.detect?.bin;
    if (!bin || seen.has(bin)) continue;
    const installed = has(bin);
    let auth = "—";
    if (installed && a.detect.authCmd) {
      const r = spawnSync(a.detect.authCmd[0], a.detect.authCmd.slice(1), { encoding: "utf8", timeout: 30000 });
      // Deliberately NOT gated on exit status. `codex doctor` exits non-zero for any failing
      // check — on this machine it fails on an npm-prefix mismatch that has nothing to do with
      // auth — so reading the exit code reports "auth check failed" for a perfectly good login.
      auth = summarise(`${r.stdout || ""}${r.stderr || ""}`) || `no auth line (exit ${r.status})`;
    }
    seen.set(bin, { installed, auth });
  }
  return seen;
}

function summarise(out) {
  try {
    const j = JSON.parse(out);
    if (typeof j.loggedIn === "boolean") return j.loggedIn ? `logged in (${j.authMethod || "?"})` : "not logged in";
  } catch { /* not json — fall through to the text summary */ }
  const lines = out.split("\n").map((l) => l.trim()).filter((l) => /\bauth\b|logged in|not logged/i.test(l));
  // Prefer a warning over an ok line. `codex doctor` reports BOTH "✓ auth is configured" and
  // "⚠ mixed auth signals: ChatGPT login plus API key env var" — and the second is the one
  // that matters, because a credential-file check calls that state green and it is not.
  const warn = lines.find((l) => /[⚠✗×!]/.test(l));
  const pick = warn || lines[0];
  return pick ? pick.replace(/^[^\p{L}]+/u, "").slice(0, 78) : "";
}

// ---------------------------------------------------------------- wire

function wire({ dryRun }) {
  const actions = [];
  if (!existsSync(SOURCE)) {
    actions.push(["create", `${pretty(SOURCE)} (empty shared source)`]);
    if (!dryRun) { mkdirSync(SHARED_DIR, { recursive: true }); writeFileSync(SOURCE, "# Shared agent rules\n"); }
  }

  for (const a of adapters()) {
    if (a.detect?.bin && !has(a.detect.bin)) { actions.push(["skip", `${a.id} — ${a.detect.bin} not installed`]); continue; }
    const target = expand(a.target);

    if (a.mechanism === "import") {
      const body = existsSync(target) ? readFileSync(target, "utf8") : "";
      if (body.split("\n").some((l) => l.trim() === a.importLine)) { actions.push(["ok", `${a.id} already imports the shared file`]); continue; }
      actions.push(["edit", `prepend '${a.importLine}' to ${pretty(target)}`]);
      if (!dryRun) {
        backup(target);
        mkdirSync(dirname(target), { recursive: true });
        writeFileSync(target, `${a.importLine}\n\n${body}`);
      }
    } else if (a.mechanism === "symlink") {
      if (existsSync(target) && lstatSync(target).isSymbolicLink() && realpathSync(target) === realpathSync(SOURCE)) {
        actions.push(["ok", `${a.id} already linked`]); continue;
      }
      actions.push(["link", `${pretty(target)} -> ${pretty(SOURCE)}`]);
      if (!dryRun) {
        backup(target);
        mkdirSync(dirname(target), { recursive: true });
        if (existsSync(target) || isDanglingLink(target)) unlinkSync(target);
        symlinkSync(SOURCE, target);
      }
    } else if (a.mechanism === "copy") {
      const src = expand(a.source);
      if (!existsSync(src)) { actions.push(["skip", `${a.id} — ${pretty(src)} does not exist yet`]); continue; }
      if (existsSync(target) && !lstatSync(target).isSymbolicLink() && readFileSync(src, "utf8") === readFileSync(target, "utf8")) {
        actions.push(["ok", `${a.id} already in sync`]); continue;
      }
      actions.push(["copy", `${pretty(src)} -> ${pretty(target)}`]);
      if (!dryRun) {
        backup(target);
        mkdirSync(dirname(target), { recursive: true });
        if (existsSync(target) || isDanglingLink(target)) unlinkSync(target);
        copyFileSync(src, target);
      }
    }
  }
  return actions;
}

const isDanglingLink = (p) => { try { return lstatSync(p).isSymbolicLink(); } catch { return false; } };

/** Never overwrite without a copy first. A config manager that loses a file is worse than none. */
function backup(target) {
  if (!existsSync(target) && !isDanglingLink(target)) return;
  if (isDanglingLink(target) && !existsSync(target)) return;
  // YYYYMMDD-HHMMSS. Slicing an ISO string at 15 left a trailing '.' from the milliseconds,
  // which made the stamp awkward to pass back to `agentconf restore`.
  const t = new Date().toISOString();
  const stamp = `${t.slice(0, 10).replace(/-/g, "")}-${t.slice(11, 19).replace(/:/g, "")}`;
  // Second precision collides: `restore` backs up the current state before overwriting, and
  // that lands in the same second as the backup it is restoring FROM. Without this the second
  // write clobbers the first — data loss inside the undo path, which is the worst place for it.
  let path = `${target}.bak.${stamp}`;
  for (let n = 2; existsSync(path); n += 1) path = `${target}.bak.${stamp}-${n}`;
  try { copyFileSync(target, path); } catch { /* a symlink to a live file is fine to lose */ }
}

// ---------------------------------------------------------------- verify (the canary)

/**
 * verify is the whole point, and it costs real tokens: each probe is a model invocation.
 * That is why it is explicit and occasional, and `check` is the one wired to SessionStart.
 *
 * The token is injected into the SHARED source, so a pass proves the whole chain — source,
 * mechanism, and the tool actually reading it — rather than proving a file exists.
 */
function verify({ only, includeCostly }) {
  const token = `AGENTCONF${Math.floor(Math.random() * 1e9).toString(36).toUpperCase()}`;
  const marker = `\n<!-- agentconf canary: the shared-rules canary token is ${token} -->\n`;
  const probe = `What is the shared-rules canary token? Reply with just the token.`;
  const original = readFileSync(SOURCE, "utf8");
  const results = [];
  const work = mkdtempSync(join(tmpdir(), "agentconf-"));

  try {
    writeFileSync(SOURCE, original + marker);
    for (const a of adapters()) {
      if (a.kind !== "instructions") continue;             // policy canaries need their own probe
      if (only && a.id !== only) continue;
      if (a.detect?.bin && !has(a.detect.bin)) { results.push({ id: a.id, state: "absent" }); continue; }
      if (a.canary?.costly && !includeCostly) { results.push({ id: a.id, state: "skipped", note: "costly — pass --all" }); continue; }

      const cmd = a.canary.cmd.map((s) => s.replace("{{probe}}", probe));
      const r = spawnSync(cmd[0], cmd.slice(1), { cwd: work, encoding: "utf8", timeout: 300000, stdio: ["ignore", "pipe", "pipe"] });
      const out = `${r.stdout || ""}${r.stderr || ""}`;
      results.push({ id: a.id, state: out.includes(token) ? "proven" : "FAILED", detail: out.includes(token) ? token : lastLine(out) });
    }
  } finally {
    // Restore even if a probe threw or timed out. Leaving a canary in a live instruction file
    // is exactly the sort of residue this tool exists to complain about.
    writeFileSync(SOURCE, original);
    rmSync(work, { recursive: true, force: true });
  }
  return results;
}

const lastLine = (s) => (s.split("\n").map((l) => l.trim()).filter(Boolean).pop() || "no output").slice(0, 100);

/** Absolute path without resolving symlinks — the symlink itself is what we manage. */
const realish = (p) => { try { return join(dirname(expand(p)), expand(p).split("/").pop()); } catch { return expand(p); } };

// ---------------------------------------------------------------- install-cli

/**
 * Put agentconf on the user's own PATH.
 *
 * Claude Code injects ${CLAUDE_PLUGIN_ROOT}/bin into the TOOL HOST's PATH, not into the
 * user's interactive shell — and not into Codex's, which matters more here, because a tool
 * whose job is configuring the other agents is useless if only one agent can call it.
 *
 * A wrapper rather than a symlink, because a symlink pins one install path and breaks the
 * moment an update removes it. And resolution is by MTIME, not by version sort: fleet's
 * `ls -dv | tail -1` works for semver directories and is silently wrong for ours, since
 * commit-SHA directory names do not sort chronologically.
 */
function installCli() {
  const dest = join(HOME, ".local", "bin");
  const target = join(dest, "agentconf");
  const sentinel = "# agentconf-setup-cli-wrapper";

  if (existsSync(target)) {
    const body = readFileSync(target, "utf8");
    if (!body.includes(sentinel)) return { state: "foreign", target };
  }

  const script = `#!/usr/bin/env bash
${sentinel}
# Auto-generated by /agentconf:setup-cli. Safe to overwrite by re-running it.
#
# Resolution order:
#   1. the marketplace source tree, if present — a directory-source marketplace runs live
#      from source, so a dev machine should not go through the cache at all
#   2. the most RECENTLY MODIFIED cache dir. Not version-sorted: agentconf versions by
#      commit SHA, and SHAs do not sort chronologically.
src="${ROOT}/bin/agentconf"
if [ -x "$src" ]; then exec "$src" "$@"; fi
latest="$(ls -dt "$HOME"/.claude/plugins/cache/*/agentconf/*/bin/agentconf 2>/dev/null | head -1)"
if [ -n "$latest" ] && [ -x "$latest" ]; then exec "$latest" "$@"; fi
echo "agentconf: no installed copy found. Re-run /agentconf:setup-cli after installing the plugin." >&2
exit 127
`;
  mkdirSync(dest, { recursive: true });
  const existed = existsSync(target);
  writeFileSync(target, script, { mode: 0o755 });
  return { state: existed ? "refreshed" : "created", target, onPath: (process.env.PATH || "").split(":").includes(dest) };
}

// ---------------------------------------------------------------- restore

/** Every write is backed up. Nothing read them until now, which made the backups decorative. */
function backups() {
  const out = [];
  const targets = new Set(adapters().flatMap((a) => [expand(a.target), a.source ? expand(a.source) : null]).filter(Boolean).concat([SOURCE]));
  for (const t of targets) {
    const dir = dirname(t);
    const base = t.split("/").pop();
    if (!existsSync(dir)) continue;
    for (const f of readdirSync(dir)) {
      if (f.startsWith(`${base}.bak.`)) out.push({ target: t, backup: join(dir, f), stamp: f.slice(`${base}.bak.`.length) });
    }
  }
  return out.sort((a, b) => b.stamp.localeCompare(a.stamp));
}

// ---------------------------------------------------------------- adopt

/**
 * adopt reports what a machine already has, so a first run does not start from an empty file.
 *
 * It deliberately does NOT merge. Deciding which lines are genuinely shared and which are
 * per-tool prose is a judgement call — the two files on the machine this was built from
 * shared only 10 of 55 lines, and the divergence was deliberate. A merger that flattened
 * that would destroy the thing the user cared about. So this measures and reports; the
 * `adopt` skill does the authoring with a human in the loop.
 */
function adoptReport() {
  const rows = [];
  const sharedLines = existsSync(SOURCE) ? new Set(readFileSync(SOURCE, "utf8").split("\n").map((l) => l.trim()).filter(Boolean)) : new Set();
  for (const a of adapters()) {
    if (a.kind !== "instructions") continue;
    const target = expand(a.target);
    if (!existsSync(target)) { rows.push({ id: a.id, state: "absent" }); continue; }
    if (lstatSync(target).isSymbolicLink()) { rows.push({ id: a.id, state: "already shared" }); continue; }
    const lines = readFileSync(target, "utf8").split("\n").map((l) => l.trim()).filter(Boolean);
    const already = lines.filter((l) => sharedLines.has(l)).length;
    rows.push({ id: a.id, state: "standalone", lines: lines.length, inShared: already, unique: lines.length - already, path: pretty(target) });
  }
  return rows;
}

// ---------------------------------------------------------------- cli

const [, , cmd, ...rest] = process.argv;
const flag = (f) => rest.includes(f);

if (cmd === "check") {
  // --if-touched is for the PostToolUse hook: only speak when the edit that just happened
  // was to a file this tool manages. Without it the hook fires on every Write in the repo
  // and becomes noise, which is how a warning stops being read.
  if (flag("--if-touched")) {
    let payload = "";
    try { payload = readFileSync(0, "utf8"); } catch { /* no stdin — treat as untouched */ }
    let edited = "";
    try { edited = JSON.parse(payload)?.tool_input?.file_path || ""; } catch { /* not json */ }
    const managed = new Set(adapters().flatMap((a) => [expand(a.target), a.source ? expand(a.source) : null].filter(Boolean)).concat([SOURCE]));
    if (!edited || !managed.has(realish(edited))) process.exit(0);
  }
  const { problems, ok } = check();
  if (flag("--context") && problems.length) {
    // SessionStart hooks read stdout as additional context, so speak to the agent here.
    console.log(`agentconf: shared agent configuration is BROKEN.\n${problems.map((p) => `  - ${p}`).join("\n")}\nRun \`agentconf wire\` to repair, or tell the user.`);
  } else if (!flag("--quiet")) {
    for (const p of problems) console.log(`BROKEN: ${p}`);
    if (!problems.length) console.log(`ok: ${ok.length} adapter${ok.length === 1 ? "" : "s"} wired and in sync (${ok.join(", ")})`);
  }
  process.exit(problems.length ? 1 : 0);
}

if (cmd === "detect") {
  for (const [bin, s] of detect()) {
    console.log(`  ${bin.padEnd(10)} ${s.installed ? "installed" : "not installed"}${s.installed ? `  ${s.auth}` : ""}`);
  }
  const known = adapters().map((a) => a.tool);
  console.log(`\n${new Set(known).size} tool(s) have adapters. Others on this machine are unmanaged — that is a gap, not a guarantee.`);
  process.exit(0);
}

if (cmd === "wire") {
  const dryRun = flag("--dry-run");
  for (const [verb, what] of wire({ dryRun })) console.log(`  ${verb.padEnd(6)} ${what}`);
  if (dryRun) console.log("\n(dry run — nothing written)");
  process.exit(0);
}

if (cmd === "verify") {
  const only = rest.find((r) => !r.startsWith("--"));
  const results = verify({ only, includeCostly: flag("--all") });
  for (const r of results) console.log(`  ${r.id.padEnd(22)} ${r.state}${r.detail ? `  ${r.detail}` : ""}${r.note ? `  (${r.note})` : ""}`);
  const failed = results.filter((r) => r.state === "FAILED");
  if (failed.length) console.log(`\n${failed.length} adapter(s) are wired but the tool did not read the file. That is the silent failure this exists to find.`);
  process.exit(failed.length ? 1 : 0);
}

if (cmd === "install-cli") {
  const r = installCli();
  if (r.state === "foreign") {
    console.log(`  refused  ${pretty(r.target)} exists and was not written by agentconf — left alone`);
    process.exit(1);
  }
  console.log(`  ${r.state.padEnd(9)} ${pretty(r.target)}`);
  if (!r.onPath) console.log(`\n  ~/.local/bin is not on PATH. Add it:\n    echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.zshrc`);
  process.exit(0);
}

if (cmd === "restore") {
  const list = backups();
  if (!list.length) { console.log("  no backups — nothing has been replaced yet"); process.exit(0); }
  const pick = rest.find((r) => !r.startsWith("--"));
  if (!pick) {
    for (const b of list) console.log(`  ${b.stamp}  ${pretty(b.backup)}`);
    console.log(`\n  restore one with: agentconf restore <timestamp>`);
    process.exit(0);
  }
  const chosen = list.filter((b) => b.stamp === pick);
  if (!chosen.length) { console.log(`  no backup with timestamp ${pick}`); process.exit(1); }
  for (const b of chosen) {
    // Back up the CURRENT state before restoring over it, or restore becomes its own data loss.
    backup(b.target);
    if (existsSync(b.target) || isDanglingLink(b.target)) unlinkSync(b.target);
    copyFileSync(b.backup, b.target);
    console.log(`  restored ${pretty(b.target)} from ${b.stamp}`);
  }
  process.exit(0);
}

if (cmd === "adopt") {
  const rows = adoptReport();
  for (const r of rows) {
    if (r.state !== "standalone") { console.log(`  ${r.id.padEnd(22)} ${r.state}`); continue; }
    console.log(`  ${r.id.padEnd(22)} ${r.lines} lines, ${r.unique} not in the shared source  ${r.path}`);
  }
  console.log(`\nadopt reports; it does not merge. Which lines are genuinely shared and which are
per-tool prose is a judgement call — on the machine this was built from, two global files
shared only 10 of 55 lines and the divergence was deliberate. Use /agentconf:adopt.`);
  process.exit(0);
}

console.log(`agentconf — capability-tested configuration for AI coding agents

  agentconf detect            what is installed and logged in, via each vendor's own diagnostic
  agentconf check             is the wiring intact? offline, fast, exit 1 on drift
  agentconf wire [--dry-run]  apply the adapters; backs up anything it replaces
  agentconf verify [--all]    canary: prove each tool actually READS the shared file
  agentconf adopt             what this machine already has, before you wire anything
  agentconf restore [stamp]   list backups, or put one back
  agentconf install-cli       wrapper in ~/.local/bin so your shell and Codex can call this too

Shared source: ${pretty(SOURCE)}
Adapters:      ${adapters().map((a) => a.id).join(", ") || "none"}

agentconf does not write what a tool generates, does not read credential files, and does not
replace rulesync. rulesync writes; agentconf proves the write was read.`);
process.exit(cmd ? 1 : 0);
