{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "agentconf check --quiet --context" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "agentconf check --quiet --context --if-touched" }
        ]
      }
    ]
  }
}
