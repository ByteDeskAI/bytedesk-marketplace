#!/usr/bin/env node
/**
 * Live board. Serves the built Atlassian Design System SPA from dashboard/dist,
 * exposes index.json at /api/board, streams events.jsonl over SSE at /events, and streams a
 * task's work — the claiming session's transcript — at /api/task/:id/stream.
 *
 * dist/ is committed: `/plugin install` must never require an npm install.
 * Rebuild it with `cd dashboard && npm run build` after changing dashboard/src.
 *
 * One dashboard per project, first-wins: a second launch finds the running one,
 * prints its URL and exits. The port is assigned once — probed free above 45000
 * and persisted — so the project opens at the same URL on every load.
 *
 *   tm-dashboard             start, or report the one already running
 *   tm-dashboard --status    print url/pid/port; exit 1 if nothing is running
 *   tm-dashboard --restart   evict the incumbent and take over
 *   tm-dashboard --help      this, and exit
 *
 * ponytail: node stdlib only, no build step. The lock lives in lib/singleton.mjs.
 */
import { createServer } from "node:http";
import { existsSync, readFileSync, statSync, watch, openSync, readSync, closeSync } from "node:fs";
import { basename, dirname, join, normalize, resolve, sep } from "node:path";
import { fileURLToPath } from "node:url";
import { ensureDirs, paths } from "../lib/paths.mjs";
import { reindex } from "../lib/store.mjs";
import { assignPort, ensurePort, liveInstance, release, takeover, writeInstance } from "../lib/singleton.mjs";
import { boardPayload, handleAsync } from "../lib/dashboard-api.mjs";
import { exportStore } from "../lib/export.mjs";
import { createHash } from "node:crypto";
import { launchBrowserEnabled } from "../lib/settings.mjs";
import { openUrl } from "../lib/open-url.mjs";
import { CATALOG } from "../lib/ntfy.mjs";
import { collapseLog } from "../lib/render.mjs";
import { workStream } from "../lib/transcript.mjs";
import { kindOf, read as readEntity, readEvents, state } from "../lib/store.mjs";
import { PREVIEWABLE, attachEvidence, servableEvidencePath } from "../lib/evidence.mjs";
import { attachToSession, attachmentPath } from "../lib/planner.mjs";
import { subscribe as subscribePlanner } from "../lib/planner-run.mjs";

// Degrade like `tm` does. Launched from a directory with no resolvable store —
// an installed copy of the plugin — a raw stack trace is a terrible answer.
/**
 * Flags, handled before `paths()` and `ensureDirs()` below, because those have side effects and a
 * request for help should have none.
 *
 * An unrecognised flag is REFUSED rather than ignored. Ignoring it is how `tm-dashboard --help`
 * silently started a server instead of printing anything: the flag fell through every check and
 * the process went on to bind a port and serve the board. It looked like a hung help invocation in
 * `ps` for as long as it ran, and the only way to tell it apart from a real board was to ask the
 * port what it was serving.
 */
const FLAGS = new Set(["--status", "--restart", "--browser", "--no-browser", "--help", "-h"]);
const args = new Set(process.argv.slice(2));

const USAGE = [
  "task-management board — one dashboard per project, first-wins.",
  "",
  "  tm-dashboard             start, or report the one already running",
  "  tm-dashboard --status    print url/pid/port; exit 1 if nothing is running",
  "  tm-dashboard --restart   evict the incumbent and take over",
  "  tm-dashboard --help      this, and exit",
  "",
  "  --browser / --no-browser   override board.launchBrowser for this run",
  "",
  "The port is assigned once, probed free above 45000 and persisted, so the project",
  "opens at the same URL every time. TM_DASHBOARD_PORT overrides it without changing",
  "the stored assignment.",
].join("\n");

if (args.has("--help") || args.has("-h")) {
  process.stdout.write(`${USAGE}\n`);
  process.exit(0);
}
const unknown = [...args].filter((a) => !FLAGS.has(a));
if (unknown.length) {
  process.stderr.write(`tm-dashboard: unknown option ${unknown.join(", ")}\n\n${USAGE}\n`);
  process.exit(2);
}

const resolved = paths();
if (!resolved.root) {
  process.stderr.write(`${resolved.unavailable}\n`);
  process.exit(1);
}
const P = ensureDirs(resolved);
const HERE = dirname(fileURLToPath(import.meta.url));
const DIST = resolve(HERE, "..", "dashboard", "dist");
const PAGE = join(DIST, "index.html");
const TYPES = {
  ".js": "text/javascript; charset=utf-8",
  ".css": "text/css; charset=utf-8",
  ".html": "text/html; charset=utf-8",
  ".json": "application/json",
  ".svg": "image/svg+xml",
  ".woff2": "font/woff2",
  ".map": "application/json",
  ".png": "image/png",
  ".jpg": "image/jpeg",
  ".jpeg": "image/jpeg",
  ".gif": "image/gif",
  ".webp": "image/webp",
  ".log": "text/plain; charset=utf-8",
  ".txt": "text/plain; charset=utf-8",
  ".md": "text/markdown; charset=utf-8",
  ".webmanifest": "application/manifest+json",
};

/** JSON body is 256 KB; a screenshot is not. Multipart lives here for that reason. */
const MULTIPART_MAX = 8 * 1024 * 1024;

function indexOfBuf(buf, needle, from = 0) {
  if (typeof buf.indexOf === "function") {
    const at = buf.indexOf(needle, from);
    return at;
  }
  return -1;
}

function parseMultipart(buf, contentType) {
  const bm = /boundary=(?:"([^"]+)"|([^;]+))/i.exec(contentType || "");
  if (!bm) return [];
  const boundary = Buffer.from(`--${(bm[1] || bm[2]).trim()}`);
  const parts = [];
  let start = indexOfBuf(buf, boundary);
  if (start < 0) return [];
  start += boundary.length;
  while (start < buf.length) {
    if (buf[start] === 13 && buf[start + 1] === 10) start += 2;
    const next = indexOfBuf(buf, boundary, start);
    if (next < 0) break;
    let end = next;
    if (end >= 2 && buf[end - 2] === 13 && buf[end - 1] === 10) end -= 2;
    parts.push(buf.subarray(start, end));
    start = next + boundary.length;
    if (buf[start] === 45 && buf[start + 1] === 45) break;
  }
  return parts.map((part) => {
    const sep = indexOfBuf(part, Buffer.from("\r\n\r\n"));
    if (sep < 0) return null;
    const headers = part.subarray(0, sep).toString("utf8");
    const body = part.subarray(sep + 4);
    const dispo = /content-disposition:\s*form-data;\s*(.*)/i.exec(headers);
    if (!dispo) return null;
    return {
      name: /(?:^|;)\s*name="([^"]*)"/i.exec(dispo[1])?.[1],
      filename: /(?:^|;)\s*filename="([^"]*)"/i.exec(dispo[1])?.[1],
      buffer: body,
    };
  }).filter(Boolean);
}

/** The two things that may be uploaded, and nothing else. */
const UPLOADS = [
  { kind: "evidence", re: /^\/api\/task\/([^/?]+)\/evidence$/ },
  { kind: "planner", re: /^\/api\/planner\/([^/?]+)\/attachment$/ },
];

function uploadTarget(url) {
  const path = (url || "").split("?")[0];
  for (const u of UPLOADS) {
    const m = u.re.exec(path);
    if (m) return { kind: u.kind, id: decodePath(m[1]) };
  }
  return null;
}

function receiveMultipart(req, res) {
  const target = uploadTarget(req.url) || { kind: "evidence", id: "" };
  const id = target.id;
  const chunks = [];
  let n = 0;
  let tooBig = false;
  req.on("data", (chunk) => {
    n += chunk.length;
    if (n > MULTIPART_MAX) {
      tooBig = true;
      json(res, 413, { error: "body too large" });
      req.destroy();
      return;
    }
    chunks.push(chunk);
  });
  req.on("end", () => {
    if (tooBig) return;
    if (target.kind === "planner") {
      const parts = parseMultipart(Buffer.concat(chunks), req.headers["content-type"]);
      const file = parts.find((part) => part.filename);
      if (!file) return json(res, 400, { error: "a planning attachment needs a file" });
      try {
        // Every rule lives in lib/planner.mjs: the allowlist, the magic-byte check, the size and
        // count bounds, the content-addressed name. This layer only carries the bytes across.
        const { attachment, session } = attachToSession(id, { filename: file.filename, buffer: file.buffer }, P);
        return json(res, 201, { attached: attachment, attachments: session.attachments });
      } catch (err) {
        return json(res, err.status || 400, { error: err.message });
      }
    }
    if (kindOf(id) !== "task" || !readEntity(id, P)) {
      return json(res, kindOf(id) === "task" ? 404 : 400, { error: kindOf(id) === "task" ? `not found: ${id}` : `not a task id: ${id}` });
    }
    const parts = parseMultipart(Buffer.concat(chunks), req.headers["content-type"]);
    const file = parts.find((p) => p.filename);
    const text = parts.find((p) => p.name === "text" && !p.filename);
    try {
      if (file) {
        const { ref } = attachEvidence(id, { filename: file.filename, buffer: file.buffer }, P);
        return json(res, 200, { attached: ref, evidence: readEntity(id, P).evidence });
      }
      if (text) {
        const { ref } = attachEvidence(id, { text: text.buffer.toString("utf8") }, P);
        return json(res, 200, { attached: ref, evidence: readEntity(id, P).evidence });
      }
      return json(res, 400, { error: "evidence needs text, path, a file, or detach" });
    } catch (err) {
      return json(res, 400, { error: err.message });
    }
  });
}
const url = (port) => `http://127.0.0.1:${port}`;

// ── singleton, first-wins ────────────────────────────────────────────────────
if (args.has("--status")) {
  const live = liveInstance(P);
  if (!live) {
    process.stderr.write(`no dashboard running for ${P.root}\n`);
    process.exit(1);
  }
  process.stdout.write(`${url(live.port)}  pid ${live.pid}  port ${live.port}  (${P.root})\n`);
  process.exit(0);
}

const evicted = args.has("--restart") ? takeover(P) : null;
if (!args.has("--restart")) {
  const live = liveInstance(P);
  if (live) {
    const u = url(live.port);
    process.stdout.write(`task-management board already running: ${u}  (pid ${live.pid})\n`);
    if (launchBrowserEnabled(P, process.env, process.argv)) openUrl(u);
    process.exit(0);
  }
  release(P); // stale pid file — take it over
}

const assignment = await ensurePort(P, {
  override: process.env.TM_DASHBOARD_PORT,
  keep: Boolean(evicted), // our own incumbent still holds it for a moment
});
if (assignment.source === "reassigned") {
  process.stdout.write(`port ${assignment.previous} is taken — reassigned this project to ${assignment.port}\n`);
}

// ── SSE fan-out ──────────────────────────────────────────────────────────────
/**
 * Every frame carries `id: <byte offset>` — the end of that line in events.jsonl — so a client
 * that reconnects sends `Last-Event-ID` and gets exactly what it missed, without a sequence
 * counter on disk. `event: store` is a JSONL row; `event: resync` says the log rotated or was
 * truncated and a full refetch is the only honest answer; `event: ready` opens the stream with
 * the offset the client should remember. A `: ping` every 25 s keeps proxies and the service
 * worker from dropping an idle stream, which they do around the 30–60 s mark.
 */
const subscribers = new Set();
const frame = (event, data, id) => `${id != null ? `id: ${id}\n` : ""}event: ${event}\ndata: ${data}\n\n`;
const broadcast = (event, data, id) => {
  const text = frame(event, data, id);
  for (const res of subscribers) res.write(text);
};

let offset = existsSync(P.events) ? statSync(P.events).size : 0;

/** The lines in [from, to) with the offset each one ends at. */
function slice(from, to) {
  const fd = openSync(P.events, "r");
  const buf = Buffer.alloc(to - from);
  readSync(fd, buf, 0, buf.length, from);
  closeSync(fd);
  const out = [];
  let at = from;
  for (const line of buf.toString("utf8").split("\n")) {
    at += Buffer.byteLength(line, "utf8") + 1;
    if (line) out.push({ line, id: Math.min(at, to) });
  }
  return out;
}

function tail() {
  if (!existsSync(P.events)) return;
  const size = statSync(P.events).size;
  if (size < offset) {
    offset = 0; // truncated or rotated — nothing a client holds is addressable any more
    broadcast("resync", JSON.stringify({ reason: "rotated", offset: size }));
  }
  if (size === offset) return;
  const rows = slice(offset, size);
  offset = size;
  for (const { line, id } of rows) broadcast("store", line, id);
}
try {
  watch(P.base, { persistent: true }, (_e, file) => {
    if (file === "events.jsonl") tail();
  });
} catch {
  setInterval(tail, 2000); // fs.watch unavailable — poll instead
}
setInterval(() => {
  for (const res of subscribers) res.write(": ping\n\n");
}, 25_000).unref();

// ── server ───────────────────────────────────────────────────────────────────
const json = (res, status, payload) => {
  res.writeHead(status, { "content-type": "application/json", "cache-control": "no-store" });
  res.end(JSON.stringify(payload));
};

/**
 * Why a write should be refused as cross-origin, or null to let it through.
 *
 * The old rule accepted any origin starting `http://127.0.0.1:` or `http://localhost:` — i.e.
 * EVERY port on this machine counted as this board. Any other local dev server, and any page it
 * serves, could POST `{"title":"Unapproved"}` to `/api/epic` and create and activate an epic; a
 * simple `text/plain` form post needs no CORS permission because it never reads the response. And
 * a request with no `Origin` at all skipped the check entirely, which is how that form post
 * arrives.
 *
 * So: an `Origin`, when present, must be exactly this server's own. And `Sec-Fetch-Site` catches
 * what `Origin` misses — every current browser sends it on every request, and only a browser
 * sends it, so a value other than `same-origin`/`none` is a page somewhere else asking. A CLI
 * client (curl, the plugin's own scripts) sends neither header and is unaffected.
 */
function crossOriginRefusal(req) {
  const site = req.headers["sec-fetch-site"];
  if (site && site !== "same-origin" && site !== "none") {
    return "cross-origin writes are refused";
  }
  // The HOST is checked first, and against what this server actually bound rather than against
  // itself. Comparing `Origin` to `http://${req.headers.host}` compares two values the attacker
  // supplies: a page on evil.com whose name resolves to 127.0.0.1 sends `Host: evil.com` AND
  // `Origin: http://evil.com`, they match, and the browser calls it same-origin so `Sec-Fetch-Site`
  // agrees. That is DNS rebinding, and it is the standard way a website reaches a service bound to
  // loopback. This server listens on 127.0.0.1 only, so the only names that can legitimately
  // address it are the loopback literals.
  const host = String(req.headers.host || "");
  const [hostname, hostPort] = host.startsWith("[") ? [host.slice(0, host.indexOf("]") + 1), host.slice(host.indexOf("]") + 2)] : host.split(":");
  if (!LOOPBACK_NAMES.has(hostname) || (hostPort && Number(hostPort) !== boundPort)) {
    return "this board answers only to 127.0.0.1 — refusing a request addressed to another name";
  }
  const origin = req.headers.origin;
  if (origin && origin !== `http://${host}`) {
    return "cross-origin writes are refused";
  }
  return null;
}

/** The names that can legitimately reach a server bound to 127.0.0.1. Anything else is rebinding. */
const LOOPBACK_NAMES = new Set(["127.0.0.1", "localhost", "[::1]", "::1", ""]);
let boundPort = null;

/** A path component a client controls; `%` alone throws URIError, which must not reach the server. */
function decodePath(raw) {
  try {
    return decodeURIComponent(raw);
  } catch {
    return null;
  }
}

const server = createServer((req, res) => {
  // ── writes ────────────────────────────────────────────────────────────────
  // Local-only server, but a browser page on another origin could still POST here,
  // so require a same-origin fetch and cap the body.
  if (req.method === "POST" || req.method === "PATCH") {
    const refusal = crossOriginRefusal(req);
    if (refusal) return json(res, 403, { error: refusal });
    const upload = req.method === "POST" && uploadTarget(req.url)
      && String(req.headers["content-type"] || "").includes("multipart/form-data");
    if (upload) {
      receiveMultipart(req, res);
      return;
    }
    let raw = "";
    let tooBig = false;
    req.on("data", (chunk) => {
      raw += chunk;
      if (raw.length > 256_000 && !tooBig) {
        tooBig = true;
        json(res, 413, { error: "body too large" });
        req.destroy();
      }
    });
    req.on("end", () => {
      if (tooBig) return;
      let body;
      try {
        body = raw ? JSON.parse(raw) : {};
      } catch {
        return json(res, 400, { error: "body is not valid JSON" });
      }
      // A write must never take the board down with it.
      handleAsync(req.method, req.url || "", body, { p: P })
        .then((result) => json(res, result.status, result.body))
        .catch((err) => json(res, 500, { error: err.message }));
    });
    return;
  }

  // `GET /api/planner/%/attachment/<hash>` throws URIError out of this callback otherwise, which
  // is the HTTP server's own error path — a malformed URL taking the board down.
  const path = decodePath((req.url || "/").split("?")[0]);
  if (path === null) return json(res, 400, { error: "that URL is not valid percent-encoding" });

  // A computed document, not a file: exportStore renders the store's text. `download=1` makes
  // the browser save it; without, it renders inline for a preview.
  if (req.method === "GET" && path === "/api/export") {
    const q = new URLSearchParams((req.url || "").split("?")[1] || "");
    const format = q.get("format") || "md";
    let text;
    try {
      text = exportStore(format, {
        epic: q.get("epic") || undefined,
        status: q.get("status") || undefined,
        open: q.get("open") === "1" || q.get("open") === "true",
        events: q.get("events") === "1" || q.get("events") === "true",
        title: q.get("title") || undefined,
      }, P);
    } catch (err) {
      return json(res, 400, { error: err.message });
    }
    const type = { md: "text/markdown; charset=utf-8", csv: "text/csv; charset=utf-8", json: "application/json" }[format];
    const name = `${basename(P.root)}-board.${format}`;
    res.writeHead(200, {
      "content-type": type,
      "cache-control": "no-store",
      "content-disposition": `${q.get("download") === "1" ? "attachment" : "inline"}; filename="${name}"`,
    });
    res.end(text);
    return;
  }

  // Guarded file GET. 200 only if the ref is on this task and realpath is inside p.evidence.
  const fileGet = (req.url || "").match(/^\/api\/task\/([^/?]+)\/file(?:\?(.*))?$/);
  if (req.method === "GET" && fileGet) {
    const id = decodePath(fileGet[1]);
    const ref = new URLSearchParams(fileGet[2] || "").get("ref") || "";
    const task = kindOf(id) === "task" ? readEntity(id, P) : null;
    const dest = task && servableEvidencePath(task, ref, P);
    if (!dest) return json(res, 404, { error: "not found" });
    const ext = dest.slice(dest.lastIndexOf("."));
    /**
     * Evidence is attached by whoever can reach this board, and `attachEvidence` applies no
     * extension allowlist and no content sniff — so these bytes are as untrusted as a planner
     * attachment, and were being served far less carefully.
     *
     * An `.svg` served `inline` as `image/svg+xml` EXECUTES its own script in the dashboard's
     * origin: `<svg onload="fetch('/api/planner/…')">` reached every board write, the dispatch
     * route that spawns a worker, and the planner's propose-and-apply pair. Preview is worth
     * having, so it is kept for the types that cannot carry script, and everything else — the
     * ones the dashboard cannot render safely — downloads instead.
     *
     * The sandbox CSP goes on BOTH paths: a browser that ignores the disposition, or a type this
     * list gets wrong later, then still finds no script, no plugin and no same-origin to inherit.
     */
    const inline = PREVIEWABLE.has(ext.toLowerCase());
    res.writeHead(200, {
      "content-type": inline ? (TYPES[ext] || "text/plain; charset=utf-8") : "application/octet-stream",
      "cache-control": "no-store",
      "content-disposition": `${inline ? "inline" : "attachment"}; filename="${basename(dest)}"`,
      "content-security-policy": "sandbox; default-src 'none'",
      "x-content-type-options": "nosniff",
    });
    res.end(readFileSync(dest));
    return;
  }

  // Guarded attachment GET. 200 only when this session lists that hash and the file is there.
  // Two hardening rules the evidence route does not need. `Content-Disposition: attachment` on
  // everything: these bytes came from outside, and a page that renders them inline would let an
  // uploaded document borrow the dashboard's origin. And a `sandbox` CSP, so even if a browser
  // ignores the disposition there is no script, no plugin and no same-origin to inherit.
  const attachGet = (req.url || "").match(/^\/api\/planner\/([^/?]+)\/attachment\/([0-9a-f]{64})$/);
  if (req.method === "GET" && attachGet) {
    const dest = attachmentPath(decodePath(attachGet[1]), attachGet[2], P);
    if (!dest) return json(res, 404, { error: "not found" });
    const ext = dest.slice(dest.lastIndexOf("."));
    res.writeHead(200, {
      "content-type": TYPES[ext] || "application/octet-stream",
      "cache-control": "no-store",
      "content-disposition": `attachment; filename="${basename(dest)}"`,
      "content-security-policy": "sandbox; default-src 'none'",
      "x-content-type-options": "nosniff",
    });
    res.end(readFileSync(dest));
    return;
  }

  if (path === "/api/board") {
    // Weak validator from the derived cache: a defensive refetch when nothing changed is a 304,
    // not another 100 KB. index.json is rewritten on every store write, so mtime+size is enough.
    let etag = null;
    try {
      const st = statSync(P.index);
      etag = `W/"${createHash("sha1").update(`${st.mtimeMs}:${st.size}`).digest("hex").slice(0, 16)}"`;
    } catch {
      /* no index yet — no validator */
    }
    if (etag && req.headers["if-none-match"] === etag) {
      res.writeHead(304, { etag, "cache-control": "no-cache" });
      return res.end();
    }
    res.writeHead(200, { "content-type": "application/json", "cache-control": "no-cache", ...(etag ? { etag } : {}) });
    return res.end(JSON.stringify(boardPayload(P)));
  }
  // History for the cycle-time and burndown maths. Bounded — the page only
  // needs the recent past, and the log grows forever.
  if (path === "/api/events") {
    const q = new URLSearchParams((req.url || "").split("?")[1] || "");
    const since = q.get("since") ? Date.parse(q.get("since")) : NaN;
    const id = q.get("id");
    const limit = Math.min(Math.max(Number(q.get("limit")) || 2000, 1), 5000);
    // readEvents includes the rotated generation, so `since` can reach past the current file.
    const rows = readEvents(P)
      .filter((e) => (Number.isNaN(since) || Date.parse(e.ts) >= since) && (!id || e.id === id))
      .slice(-limit);
    /**
     * `label` is attached here rather than in the SPA because the sentences live in the ntfy
     * CATALOG, and a second copy of that vocabulary in TypeScript is a second thing to forget to
     * update — a test already derives the catalog from the source that emits the events, and that
     * guard only works if there is one catalog. `event` is left untouched: the burndown and
     * cycle-time maths match on it. `_shadowed` marks an `update` a specific event in the same
     * second already explains, so the activity panel can skip it while every consumer that
     * switches on `event.event` still receives every row.
     */
    const labelled = collapseLog(rows, { keep: true }).map((e) => ({
      ...e,
      label: CATALOG.events[e.event]?.label || e.event,
    }));
    res.writeHead(200, { "content-type": "application/json", "cache-control": "no-store" });
    res.end(JSON.stringify(labelled));
    return;
  }
  /**
   * The work behind one task: the claiming session's transcript, as TanStack AI UIMessages.
   *
   * GET only, and the module it calls does nothing but read files — the panel promises a view of
   * a run, never a handle on it. Poll-driven rather than watch-driven: the transcript lives
   * outside the store, fs.watch on another process's append is unreliable across platforms, and
   * a 2 s poll of a 200 KB tail is cheap.
   */
  /**
   * The AG-UI event stream for one planning run.
   *
   * Push, not poll: the bridge already holds the events and hands each one over as it is
   * translated. `subscribe` replays what has already happened before attaching, so a browser that
   * opens this after a run started still renders the whole trace rather than joining halfway
   * through and missing the part that explains what the agent did.
   */
  const plannerStream = req.url?.match(/^\/api\/planner\/(PL-[0-9a-f]{12})\/stream$/);
  if (plannerStream) {
    res.writeHead(200, {
      "content-type": "text/event-stream",
      "cache-control": "no-cache",
      connection: "keep-alive",
    });
    const off = subscribePlanner(plannerStream[1], (event) => {
      res.write(`data: ${JSON.stringify(event)}\n\n`);
    });
    if (!off) {
      // No run in flight. Say so and close, rather than holding a socket open on a stream that
      // will never produce anything.
      res.write(`data: ${JSON.stringify({ type: "CUSTOM", name: "tm.run.absent" })}\n\n`);
      res.end();
      return;
    }
    const ping = setInterval(() => res.write(": ping\n\n"), 25_000);
    req.on("close", () => {
      clearInterval(ping);
      off();
    });
    return;
  }

  const stream = req.url?.match(/^\/api\/task\/([\w-]+)\/stream$/);
  if (stream) {
    const id = stream[1];
    const task = readEntity(id, P);
    if (!task) {
      res.writeHead(404, { "content-type": "application/json" }).end(JSON.stringify({ error: `no such task: ${id}` }));
      return;
    }
    res.writeHead(200, {
      "content-type": "text/event-stream",
      "cache-control": "no-cache",
      connection: "keep-alive",
    });
    let last = "";
    const push = () => {
      const claim = (state(P).claims || {})[id];
      const payload = workStream(task, claim, P.root);
      const json = JSON.stringify(payload);
      if (json === last) return; // nothing new — do not wake the browser to re-render the same thing
      last = json;
      res.write(`data: ${json}\n\n`);
    };
    push();
    const timer = setInterval(push, 2000);
    req.on("close", () => clearInterval(timer));
    return;
  }
  if (path === "/events") {
    res.writeHead(200, {
      "content-type": "text/event-stream",
      "cache-control": "no-cache",
      connection: "keep-alive",
    });
    const size = existsSync(P.events) ? statSync(P.events).size : 0;
    // Parsed as an integer and clamped to the file — never a path, never an offset into anything else.
    const last = Number.parseInt(String(req.headers["last-event-id"] ?? ""), 10);
    if (Number.isInteger(last) && last >= 0) {
      if (last > size) {
        res.write(frame("resync", JSON.stringify({ reason: "rotated", offset: size })));
      } else if (last < size) {
        for (const { line, id } of slice(last, size)) res.write(frame("store", line, id));
      }
    }
    res.write(frame("ready", JSON.stringify({ offset: size, project: boardPayload(P).project })));
    subscribers.add(res);
    req.on("close", () => subscribers.delete(res));
    return;
  }
  /**
   * Every other `/api/*` read goes to the pure handler. The server used to enumerate GET paths one
   * by one, and each new read route was a line to remember here — the comment that said so was the
   * bug. What stays above this line is exactly what needs the raw socket: SSE, bytes, the export
   * document, and the board's validator.
   */
  if (req.method === "GET" && path.startsWith("/api/")) {
    handleAsync("GET", req.url || "", null, { p: P })
      .then((result) => json(res, result.status, result.body))
      .catch((err) => json(res, 500, { error: err.message }));
    return;
  }
  if (req.method !== "GET" && req.method !== "HEAD" && path.startsWith("/api/")) {
    return json(res, 405, { error: `${req.method} not allowed on ${path}` });
  }

  // Hashed build assets and the PWA's icons. The resolve+prefix check is the
  // whole traversal guard — one code path, so /icons/ cannot drift from /assets/.
  if (path.startsWith("/assets/") || path.startsWith("/icons/") || path.startsWith("/fonts/")) {
    const asset = resolve(DIST, `.${normalize(path)}`);
    if (!asset.startsWith(DIST + sep) || !existsSync(asset)) {
      res.writeHead(404).end("not found");
      return;
    }
    const ext = asset.slice(asset.lastIndexOf("."));
    res.writeHead(200, {
      "content-type": TYPES[ext] || "application/octet-stream",
      "cache-control": "public, max-age=31536000, immutable", // the filename carries the hash
    });
    res.end(readFileSync(asset));
    return;
  }

  // The manifest and the worker. Both live at the site root: the worker's scope
  // is the path it is served from, and a worker under /assets/ could not control
  // the board. The worker must never be cached — a stale one outlives a rebuild
  // and keeps serving yesterday's shell forever.
  if (path === "/sw.js" || path === "/manifest.webmanifest") {
    const file = join(DIST, path.slice(1));
    if (!existsSync(file)) {
      res.writeHead(404).end("not found — run: cd dashboard && npm run build");
      return;
    }
    res.writeHead(200, {
      "content-type": TYPES[path.slice(path.lastIndexOf("."))],
      "cache-control": "no-cache",
      ...(path === "/sw.js" ? { "service-worker-allowed": "/" } : {}),
    });
    res.end(readFileSync(file));
    return;
  }

  if (!existsSync(PAGE)) {
    res.writeHead(500, { "content-type": "text/plain; charset=utf-8" });
    res.end("dashboard/dist is missing. Build it: cd dashboard && npm run build\n");
    return;
  }
  res.writeHead(200, { "content-type": "text/html; charset=utf-8", "cache-control": "no-store" });
  res.end(readFileSync(PAGE));
});

for (const sig of ["SIGINT", "SIGTERM"]) {
  process.on(sig, () => {
    if (liveInstance(P)?.pid === process.pid) release(P);
    process.exit(0);
  });
}

/**
 * Bind the assigned port. An evicted incumbent's socket lingers a moment, so
 * hold the port through that; only genuine occupancy moves us on — and when it
 * does, the new port becomes the standing assignment.
 */
function listen(port, { waits = 0, moves = 0 } = {}) {
  server.once("error", (err) => {
    if (err.code !== "EADDRINUSE") throw err;
    if (evicted && waits < 40) return setTimeout(() => listen(port, { waits: waits + 1, moves }), 50);
    // Someone else claimed the store while we were starting — they win.
    const live = liveInstance(P);
    if (live) {
      const u = url(live.port);
      process.stdout.write(`task-management board already running: ${u}  (pid ${live.pid})\n`);
      if (launchBrowserEnabled(P, process.env, process.argv)) openUrl(u);
      process.exit(0);
    }
    if (moves < 20) {
      const next = port + 1;
      if (assignment.source !== "env") {
        assignPort(P, next);
        process.stdout.write(`port ${port} is taken — reassigned this project to ${next}\n`);
      }
      return listen(next, { moves: moves + 1 });
    }
    throw err;
  });
  server.listen(port, "127.0.0.1", () => {
    // What the origin check compares against: the port actually bound, not one a header claims.
    boundPort = port;
    writeInstance(P, { pid: process.pid, port });
    const u = url(port);
    process.stdout.write(`task-management board: ${u}  (${P.root})\n`);
    if (launchBrowserEnabled(P, process.env, process.argv)) openUrl(u);
  });
}
listen(assignment.port);
