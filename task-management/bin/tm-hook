#!/usr/bin/env node
/**
 * Hook entrypoint. Always exits 0 — a hook bug must never brick the session.
 * Gate decisions still reach the host as JSON on stdout.
 *
 * Node, not bash: Codex/Grok/Windows have no plugin-root substitution and no
 * guaranteed GNU userland. stdin is the hook payload.
 */
import { spawnSync } from "node:child_process";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { readFileSync } from "node:fs";

const PLUGIN_ROOT = join(dirname(fileURLToPath(import.meta.url)), "..");
const event = process.argv[2] || "";
if (!event) process.exit(0);

let input = Buffer.alloc(0);
try {
  input = readFileSync(0);
} catch {
  /* empty stdin */
}

// TM-177: the dispatch worker guard — the one event that blocks by exit code rather than JSON.
// hooks/tm-hook.sh already returned for non-workers without starting Node; this check covers hosts
// that run this file directly (the Codex launcher). In a worker it fails SAFE: anything it cannot
// read or run is refused, because the worker is running with every permission prompt skipped.
if (event === "pre-bash") {
  // TM-470: a worker by recorded dispatch ancestry OR its env marker — unsetting the marker is no exit.
  const { isWorkerCaller } = await import("../lib/worker-identity.mjs");
  const who = isWorkerCaller();
  if (!who.worker) process.exit(0);
  /**
   * TM-481 C1: the pins come from THIS process's env — the harness's, set at spawn, which no Bash call
   * the worker makes can edit. The registry record is a same-UID file the worker can rewrite, so it is
   * never preferred: it can only add a restriction (governed), and a record that disagrees with the
   * env is itself a refusal. A pin the env lacks stays null, and a null branch or repo allows nothing.
   */
  const pin = {
    task: process.env.TM_DISPATCH_TASK || null,
    branch: process.env.TM_DISPATCH_BRANCH || null,
    integrationBranch: process.env.TM_DISPATCH_INTEGRATION_BRANCH || null,
    root: process.env.TM_ROOT || null,
    repo: process.env.TM_DISPATCH_REPO || null,
  };
  const conflict = Object.keys(pin).find((k) => who.record?.[k] && pin[k] && String(who.record[k]) !== String(pin[k]));

  /**
   * TM-481 C1: the guard NEVER releases. It used to stand down when the pinned task read `done`, but
   * the task file is in a store the worker can write, so a forged `status: done` released it. A
   * worker session stays guarded for its whole life; a finished worker is ended, not un-guarded.
   * The store is still read, but only to ADD a restriction: a governed task, or one that cannot be
   * identified (no TM_ROOT and no matching recorded branch), refuses every merge.
   */
  const pinnedTask = async (cwd) => {
    if (!pin.task || (!pin.root && !pin.branch)) return { task: null, identified: false };
    try {
      const [{ read }, { paths }] = await Promise.all([import("../lib/store.mjs"), import("../lib/paths.mjs")]);
      const task = read(pin.task, paths(pin.root || cwd));
      return { task, identified: Boolean(task) && (Boolean(pin.root) || task.branch === pin.branch) };
    } catch {
      return { task: null, identified: false }; // a store we cannot read identifies nothing
    }
  };

  const refuse = (why) => {
    process.stderr.write(`task-management dispatch guard (worker for ${pin.task || "an unnamed task"}): ${why}\n`);
    process.exit(2);
  };
  let payload = null;
  try {
    payload = JSON.parse(input.toString("utf8"));
  } catch {
    /* refused below */
  }
  const command = payload?.tool_input?.command;
  if (typeof command !== "string") refuse("could not read a Bash command from the PreToolUse payload, so it cannot be checked; refusing rather than guessing.");
  const payloadCwd = typeof payload.cwd === "string" && payload.cwd ? payload.cwd : process.cwd();
  if (conflict) refuse(`the dispatch record's ${conflict} (${who.record[conflict]}) disagrees with the one pinned at spawn (${pin[conflict]}); a rewritten record is refused, not believed.`);
  const pinned = await pinnedTask(payloadCwd);
  try {
    const { guardCommand } = await import("../lib/worker-guard.mjs");
    const cwd = payloadCwd;
    const { safeGitSync } = await import("../lib/safe-git.mjs");
    const rev = safeGitSync(cwd, ["rev-parse", "--abbrev-ref", "HEAD"]); // TM-443
    const head = rev.status === 0 ? rev.stdout.trim() : null;
    /**
     * TM-481: governed when dispatch recorded it, the env says so, or the task carries governance —
     * and, failing safe, when the task cannot be identified at all. A governed worker never merges.
     */
    const governed = Boolean(who.record?.governed || process.env.TM_DISPATCH_GOVERNED || !pinned.identified || pinned.task?.governance);
    /**
     * TM-481: an ungoverned worker merges its own PR only in the pinned repository (TM_DISPATCH_REPO)
     * and only when every required check has passed. H2: the repository `gh` resolves from this cwd
     * must BE the pinned one — a `cd`, `git remote set-url` or `gh-resolved` write made in an earlier
     * call shows up here — and the checks are asked of the pinned repository with -R, not the cwd's.
     */
    const requiredChecksPass = (branch) => {
      if (!pin.repo) return false;
      const gh = (args) => spawnSync("gh", args, { cwd, encoding: "utf8", timeout: 4500, windowsHide: true });
      const view = gh(["repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"]);
      if (view.status !== 0 || String(view.stdout).trim().toLowerCase() !== pin.repo.toLowerCase()) return false;
      try {
        const checks = JSON.parse(gh(["pr", "checks", branch, "-R", pin.repo, "--required", "--json", "bucket"]).stdout);
        return Array.isArray(checks) && checks.length > 0 && checks.every((c) => c.bucket === "pass");
      } catch {
        return false;
      }
    };
    // TM-481: the own branch is the PINNED one only — HEAD is what the worker checked out, not proof.
    const verdict = guardCommand(command, { branch: pin.branch || null, head, integrationBranch: pin.integrationBranch, governed, requiredChecksPass });
    if (!verdict.allow) refuse(verdict.reason);
  } catch (err) {
    refuse(`the guard itself failed (${err.message}); refusing rather than guessing.`);
  }
  process.exit(0);
}

const r = spawnSync(process.execPath, [join(PLUGIN_ROOT, "bin", "tm"), "hook", event], {
  input,
  encoding: "buffer",
  windowsHide: true,
});
if (r.stdout && r.stdout.length) process.stdout.write(r.stdout);
if (r.stderr && r.stderr.length) process.stderr.write(r.stderr);
process.exit(0);
