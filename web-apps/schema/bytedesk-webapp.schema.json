{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bytedesk.ai/gateway/bytedesk-webapp.schema.json",
  "title": "ByteDesk Web App marker",
  "description": "Portable configuration stored as .bytedesk-webapp.json at an application root.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "description"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "stackHint": { "type": "string" },
    "contextPaths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "references": {
      "type": "array",
      "items": { "type": "string" }
    },
    "services": {
      "type": "array",
      "items": { "$ref": "#/$defs/service" }
    },
    "preview": { "$ref": "#/$defs/preview" }
  },
  "$defs": {
    "commandArgument": {
      "type": "string",
      "pattern": "^(?:[^$]|\\$(?!\\{)|\\$\\{(?:PORT|services\\.[A-Za-z][A-Za-z0-9_-]*\\.port)\\})*$"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/commandArgument" },
            { "minLength": 1, "pattern": "\\S" }
          ]
        }
      ],
      "items": { "$ref": "#/$defs/commandArgument" }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "pattern": "^(?:$|/)" },
        "timeoutSeconds": { "type": "integer", "minimum": 0 },
        "intervalMillis": { "type": "integer", "minimum": 0 }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "run"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "cwd": { "type": "string" },
        "setup": {
          "type": "array",
          "items": { "$ref": "#/$defs/command" }
        },
        "run": { "$ref": "#/$defs/command" },
        "portHint": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "env": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/commandArgument" }
        },
        "envFrom": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "uniqueItems": true
        },
        "readiness": { "$ref": "#/$defs/readiness" }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service"],
      "properties": {
        "service": { "type": "string" },
        "path": { "type": "string", "pattern": "^(?:$|/)" }
      }
    }
  }
}
