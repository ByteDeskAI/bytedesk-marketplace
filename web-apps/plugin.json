{
  "id": "web-apps",
  "version": "0.2.0",
  "panels": [
    {
      "id": "web-apps",
      "kind": "web-apps",
      "url": "/p/web-apps/ui",
      "module": "/p/web-apps/assets/panel.mjs"
    },
    {
      "id": "create-web-app",
      "kind": "create-web-app",
      "url": "/p/web-apps/create",
      "module": "/p/web-apps/assets/panel.mjs"
    }
  ],
  "scopes": [
    "plugin:web-apps"
  ],
  "routes": [
    "/p/web-apps/"
  ],
  "spawn": true,
  "binary": "web-apps",
  "socket": "plugin.sock",
  "targets": [
    "gateway"
  ],
  "protocol": {
    "major": 1,
    "required": [
      "host.scoped.v1",
      "activation.check.v1",
      "ui.mount.v1"
    ]
  },
  "permissions": {
    "request": [
      "cmd.web-apps.v1.list",
      "cmd.web-apps.v1.create",
      "cmd.web-apps.v1.creation-eligibility",
      "cmd.web-apps.v1.conversation.send",
      "cmd.web-apps.v1.conversation.approve",
      "cmd.web-apps.v1.conversation.answer",
      "cmd.web-apps.v1.run.stop",
      "cmd.web-apps.v1.services.start",
      "cmd.web-apps.v1.services.stop",
      "cmd.web-apps.v1.services.logs",
      "cmd.web-apps.v1.preview.resolve",
      "cmd.web-apps.v1.preview.navigate",
      "cmd.web-apps.v1.preview.open-external"
    ]
  },
  "projectViews": [
    {
      "id": "web-apps",
      "label": "Web Apps",
      "icon": "globe",
      "order": 30,
      "panelId": "web-apps"
    }
  ],
  "directoryContextActions": [
    {
      "id": "create-web-app",
      "label": "Create Web App",
      "icon": "globe",
      "order": 40,
      "wizardPanelId": "create-web-app"
    }
  ]
}
