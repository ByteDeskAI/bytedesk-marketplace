# Per-user fleet state — never commit
.claude-sessions/
.claude/plugins/
# .bytedesk/task-management/ IS committed — the task store is shared work, and it carries
# its own .gitignore for the machine-local parts (index.json, state.json, dashboard.*).
.bytedesk/worktrees/
**/.in_use/
.claude/worktrees/
notifications.fifo
notify.log
notify.config.toml
*.events
*.events.offset
*.events.err

# Local agent stores
ruvector.db
ruvector.db.lock
agentdb.rvf
agentdb.rvf.lock
.swarm/
.claude-flow/

# Editor / OS noise
.DS_Store
*.swp
*.swo
*~

# Test artifacts
*.bak
.playwright-mcp/
*.png

# The design-system plugin and governed design mockups ship approved visual assets.
!design-system/payload/**/*.png
!.bytedesk/designer/mockups/**/*.png
!.context/design-system/**/*.png

# design-patterns plugin — Python artifacts
__pycache__/
*.pyc

dashboard.pid
dashboard.port

# PM plugin — workspace data directories (created by pm_init in-repo during dev/test)
# The real workspace lives in the user's project directory, not here.
project-management/.pm/
**/.pm/pm.db
**/.pm/pm.db-shm
**/.pm/pm.db-wal
**/.pm/events.jsonl
**/.pm/dashboard.pid
**/.pm/dashboard.port

# Claude telemetry and session artifacts
.claude/telemetry/
.claudeignore

# Agent terminal logs. `pipe-pane -o` is attached at pane creation and appends every byte the pane
# renders, so these are rewritten continuously while an agent is doing anything — TM-147.
#
# Tracking them made `git status` useless as a signal in a shared checkout: the tree was never
# clean, so every commit either swept unrelated terminal noise into itself or was made against a
# dirty tree. It cost this repository real work — a conductor once attributed a change to an
# unowned party when the only dirty file was one agent's own log, and a merge that raced a live
# pane.log write left MERGE_HEAD set and landed a branch with none of its code in it.
#
# The logs stay on disk and keep being written. They stop being repository content.
.bytedesk/agent-orchestration/agents/*/pane.log
.bytedesk/agent-orchestration/runs/*/agents/*/pane.log
