#!/usr/bin/env node
import { spawn } from "node:child_process";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const root = dirname(dirname(fileURLToPath(import.meta.url)));
const sandboxEntrypoint = join(root, "dist", "provider-sandbox.cjs");
const wslHosted = process.env.AGENT_ORCHESTRATION_HOST_PLATFORM === "win32";
const executable = wslHosted ? "/usr/bin/unshare" : process.execPath;
const args = wslHosted
  ? ["--user", "--map-root-user", process.execPath, sandboxEntrypoint, ...process.argv.slice(2)]
  : [sandboxEntrypoint, ...process.argv.slice(2)];
const child = spawn(executable, args, {
  stdio: "inherit",
  shell: false,
  windowsHide: true,
});
for (const signal of ["SIGINT", "SIGTERM"]) process.on(signal, () => child.kill(signal));
child.once("exit", (code, signal) => signal ? process.kill(process.pid, signal) : process.exit(code ?? 1));
