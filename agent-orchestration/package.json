{
  "name": "@bytedesk/agent-orchestration",
  "version": "0.2.0",
  "private": true,
  "description": "Cross-provider agent orchestration MCP server and CLI for Claude Code, Codex, Grok Build, and Kimi.",
  "type": "module",
  "main": "dist/cli.cjs",
  "bin": {
    "agent-orchestration": "bin/agent-orchestration",
    "agent-orchestration-mcp": "bin/agent-orchestration-mcp"
  },
  "files": [
    ".claude-plugin",
    ".codex-plugin",
    ".mcp.json",
    ".codex-mcp.json",
    "agents",
    "bin",
    "dist",
    "docs",
    "skills",
    "templates",
    "AGENTS.md",
    "CHANGELOG.md",
    "ROADMAP.md",
    "ROADMAP-INVENTORY.json",
    "ROADMAP-SOURCES.json",
    "README.md",
    "scripts/roadmap.mjs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/check-bundle.mjs",
    "test": "bash run-tests.sh",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:contract": "bash run-tests.sh contract",
    "test:live": "node tests/live/provider-smoke.mjs",
    "roadmap:check": "node scripts/roadmap.mjs --check ROADMAP.md",
    "roadmap:append-inventory": "node scripts/roadmap.mjs --append-inventory ROADMAP.md",
    "roadmap:refresh-sources": "node scripts/roadmap.mjs --refresh-sources ROADMAP.md",
    "roadmap:refresh-views": "node scripts/roadmap.mjs --refresh-views ROADMAP.md",
    "prepack": "npm run build:check && npm test"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.61.0",
    "@agentclientprotocol/codex-acp": "0.0.44",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "acpx": "0.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
