{
  "id": "copilot",
  "display": "GitHub Copilot CLI",
  "command": "copilot",
  "args": [],
  "model_args": ["--model", "{{model}}"],
  "system_prompt_args": [],
  "auto_approve_args": ["--allow-all-tools"],
  "ready": { "delay_ms": 6000, "timeout_ms": 30000 },
  "submit_keys": ["Enter"],
  "bootstrap_message": "Read {{bootstrap_file}} and follow it exactly. Reply with the single word READY once you have read it and every skill it lists.",
  "detect": ["copilot", "--version"],
  "install_hint": "npm install -g @github/copilot",
  "notes": "Typed-text adapter. Verify flags against `copilot --help`."
}
