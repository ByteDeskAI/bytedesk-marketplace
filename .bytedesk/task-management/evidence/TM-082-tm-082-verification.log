### step 4 (Kimi) — append the example to ~/.kimi-code/config.toml, literal command from the guide
$ cat ../bytedesk-marketplace/task-management/hooks/kimi-hooks.example.toml >> ~/.kimi-code/config.toml
(exit 0)
$ tail -12 ~/.kimi-code/config.toml (scratch HOME)
timeout = 10

[[hooks]]
event = "PostToolUse"
matcher = "TodoList"
command = ".bytedesk/task-management/bin/tm-hook post-task"
timeout = 10

[[hooks]]
event = "Stop"
command = ".bytedesk/task-management/bin/tm-hook stop"
timeout = 10
