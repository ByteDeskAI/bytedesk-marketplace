#!/usr/bin/env node
/**
 * Copy ByteDesk marketplace plugin source into installed caches (Claude, Grok, Codex).
 *
 * User-scope only. This is a machine tool, not a project one: a repo that enables
 * plugin-rsync@bytedesk in extraKnownMarketplaces is the wrong install.
 */
import { accessSync, constants, existsSync, lstatSync, mkdirSync, readFileSync, readdirSync, realpathSync, renameSync, rmSync, statSync, writeFileSync } from "node:fs";
import { randomUUID } from "node:crypto";
import { homedir } from "node:os";
import { delimiter, dirname, isAbsolute, join, relative, resolve, sep } from "node:path";
import { spawn, spawnSync } from "node:child_process";
import { createInterface } from "node:readline";
import { fileURLToPath } from "node:url";

const ROOT = dirname(dirname(fileURLToPath(import.meta.url)));
const HOME = process.env.HOME || homedir();
const EXCLUDES = ["node_modules", ".git", ".vite", "*.tsbuildinfo"];
const SENTINEL = "# plugin-rsync-setup-cli-wrapper";

const pretty = (p) => (p.startsWith(HOME) ? `~${p.slice(HOME.length)}` : p);

function readJson(file, fallback) {
  try {
    return JSON.parse(readFileSync(file, "utf8"));
  } catch {
    return fallback;
  }
}

function real(p) {
  try {
    return realpathSync(p);
  } catch {
    return resolve(p);
  }
}

function isDir(p) {
  try {
    return lstatSync(p).isDirectory();
  } catch {
    return false;
  }
}

/** Names: no args → all; `foo,bar` or `foo bar` → those. */
export function parseNames(argv) {
  const out = [];
  for (const raw of argv) {
    if (raw.startsWith("-")) continue;
    for (const part of String(raw).split(",")) {
      const n = part.trim();
      if (n) out.push(n);
    }
  }
  return [...new Set(out)];
}

export function marketplaceRoot() {
  if (process.env.BYTEDESK_MARKETPLACE) return resolve(process.env.BYTEDESK_MARKETPLACE);
  const sibling = join(ROOT, "..");
  if (existsSync(join(sibling, ".claude-plugin", "marketplace.json"))) return sibling;
  const km = readJson(join(HOME, ".claude", "plugins", "known_marketplaces.json"), {});
  const path = km?.bytedesk?.source?.path || km?.bytedesk?.installLocation;
  if (path && existsSync(join(path, ".claude-plugin", "marketplace.json"))) return path;
  const registry = readJson(join(HOME, ".grok", "installed-plugins", "registry.json"), {});
  for (const entry of Object.values(registry.repos || {})) {
    const src = entry?.kind?.source_path;
    if (typeof src !== "string") continue;
    const root = entry.kind.subdir ? src : src.replace(/[/\\][^/\\]+$/, "");
    const candidate = existsSync(join(src, ".claude-plugin", "marketplace.json"))
      ? src
      : existsSync(join(root, ".claude-plugin", "marketplace.json"))
        ? root
        : null;
    if (candidate) return candidate;
  }
  return null;
}

export function catalog(market) {
  const file = join(market, ".claude-plugin", "marketplace.json");
  const names = [];
  const sources = {};
  for (const p of readJson(file, {}).plugins || []) {
    if (!p?.name) continue;
    names.push(p.name);
    const rel = typeof p.source === "string" ? p.source : p.source?.path;
    sources[p.name] = resolve(market, rel || `./${p.name}`);
  }
  return { names, sources };
}

function addDest(map, name, dest, host) {
  if (!dest || !isDir(dest)) return;
  const key = real(dest);
  if (!map.has(name)) map.set(name, []);
  const list = map.get(name);
  if (list.some((d) => d.real === key)) return;
  list.push({ host, dest: resolve(dest), real: key });
}

function looksLikeInstall(dir) {
  return (
    existsSync(join(dir, ".claude-plugin", "plugin.json")) ||
    existsSync(join(dir, ".codex-plugin", "plugin.json"))
  );
}

function shaDirs(parent) {
  if (!isDir(parent)) return [];
  return readdirSync(parent)
    .filter((n) => !n.startsWith(".") && n !== "node_modules")
    .map((n) => join(parent, n))
    .filter((p) => isDir(p) && looksLikeInstall(p));
}

/** Installed copies of each catalog plugin on this machine. */
export function installedDests(names, home = HOME) {
  const map = new Map();
  const installed = readJson(join(home, ".claude", "plugins", "installed_plugins.json"), {});
  for (const name of names) {
    for (const rec of installed.plugins?.[`${name}@bytedesk`] || []) {
      addDest(map, name, rec.installPath, "claude");
    }
    for (const dir of shaDirs(join(home, ".claude", "plugins", "cache", "bytedesk", name))) {
      addDest(map, name, dir, "claude");
    }
    for (const dir of shaDirs(join(home, ".codex", "plugins", "cache", "bytedesk", name))) {
      addDest(map, name, dir, "codex");
    }
    const codexFlat = join(home, ".codex", "plugins", "cache", "bytedesk", name);
    if (looksLikeInstall(codexFlat)) addDest(map, name, codexFlat, "codex");
  }

  const registry = readJson(join(home, ".grok", "installed-plugins", "registry.json"), {});
  for (const entry of Object.values(registry.repos || {})) {
    const path = entry?.path;
    if (!path) continue;
    const plugins = entry.plugins || {};
    for (const name of names) {
      const meta = plugins[name];
      if (!meta) continue;
      const sub = meta.subdir || (isDir(join(path, name)) ? name : "");
      addDest(map, name, sub ? join(path, sub) : path, "grok");
    }
  }
  return map;
}

export function rsyncArgs(src, dest, extra = []) {
  const args = ["-a", "--delete", ...extra];
  for (const e of EXCLUDES) args.push("--exclude", e);
  args.push(`${src}/`, `${dest}/`);
  return args;
}

function runRsync(src, dest, dry, extra = []) {
  const args = rsyncArgs(src, dest, extra);
  if (dry) return { ok: true, dry: true, args };
  const r = spawnSync("rsync", args, { encoding: "utf8" });
  if (r.error?.code === "ENOENT") return { ok: false, err: "rsync is not on PATH" };
  if (r.status !== 0) return { ok: false, err: (r.stderr || r.stdout || `rsync exited ${r.status}`).trim() };
  return { ok: true, stdout: r.stdout || "" };
}

export const HOSTS = ["claude", "grok", "codex"];
const RELOAD_DIRS = new Set(["hooks", "skills", "commands", "agents", "monitors", ".claude-plugin", ".codex-plugin", ".grok-plugin"]);
const RELOAD_FILES = new Set([".mcp.json", ".codex-mcp.json"]);
const PROC_CODE_DIRS = new Set(["lib", "src", "dist"]);

/** `./x`, `${CLAUDE_PLUGIN_ROOT}/x`, `${CODEX_PLUGIN_ROOT}/x` or `${PLUGIN_ROOT}/x` → `x`; anything else → null. */
export function pluginRel(v) {
  const m = typeof v === "string" && v.match(/^(?:\$\{(?:CLAUDE_PLUGIN_ROOT|CODEX_PLUGIN_ROOT|PLUGIN_ROOT)\}\/|\.\/)(.+)$/);
  return m ? m[1] : null;
}

/**
 * Plugin-relative files a long-running process is launched from: MCP servers
 * (.mcp.json / .codex-mcp.json command + args) and monitors (monitors/monitors.json command
 * strings, split on whitespace).
 */
export function processEntries(pluginDir) {
  const out = new Set();
  const add = (v) => {
    const rel = pluginRel(v);
    if (rel) out.add(rel);
  };
  for (const f of RELOAD_FILES) {
    const doc = readJson(join(pluginDir, f), null);
    const servers = doc?.mcpServers || doc || {};
    for (const s of Object.values(servers)) {
      [s?.command, ...(Array.isArray(s?.args) ? s.args : [])].forEach(add);
    }
  }
  const monitors = readJson(join(pluginDir, "monitors", "monitors.json"), []);
  for (const m of Array.isArray(monitors) ? monitors : []) {
    if (typeof m?.command === "string") m.command.trim().split(/\s+/).forEach(add);
  }
  return out;
}

/**
 * live | needs-reload for one plugin-relative changed path. `procs` is processEntries() of the plugin.
 * ponytail: lib/src/dist are reload-worthy for any plugin with an MCP server or monitor, since we
 * cannot tell which modules the process imported; a per-import graph would be the upgrade.
 */
export function classify(rel, procs = new Set()) {
  const top = rel.split("/")[0];
  if (RELOAD_DIRS.has(top) || RELOAD_FILES.has(rel) || procs.has(rel)) return "needs-reload";
  if (procs.size && PROC_CODE_DIRS.has(top)) return "needs-reload";
  return "live";
}

/** Parse `rsync -i` output into changed file paths (directories dropped; their files are listed). */
export function parseItemized(stdout) {
  const out = [];
  for (const line of stdout.split("\n")) {
    const m = line.match(/^(\S{9,11}) +(.+)$/);
    if (!m || m[2].endsWith("/")) continue;
    const code = m[1];
    const path = code[1] === "L" ? m[2].replace(/ -> .*$/, "") : m[2];
    out.push({ path, change: code === "*deleting" ? "deleted" : "updated" });
  }
  return out;
}

/**
 * One run at a time: a lock directory, reclaimed when older than `staleMs` (a run killed mid-way).
 * TM-485: each run writes a random owner token into its lock. A stale lock is renamed aside and
 * removed only if the moved directory still has the token seen when it was judged stale; if another
 * run replaced it in between, that lock is put back and this run is busy. Release removes the lock
 * only while it still holds this run's token. (Not the inode: a new directory can reuse it.)
 * Returns the release function, or null when another run holds the lock.
 */
const lockOwner = (dir) => {
  try {
    return readFileSync(join(dir, "owner"), "utf8");
  } catch {
    return null;
  }
};
export function acquireLock(lock, staleMs) {
  mkdirSync(dirname(lock), { recursive: true });
  let seen = null;
  try {
    seen = statSync(lock);
  } catch {}
  if (seen && Date.now() - seen.mtimeMs > staleMs) {
    const owner = lockOwner(lock);
    const aside = `${lock}.stale-${process.pid}-${Date.now()}`;
    try {
      renameSync(lock, aside);
    } catch {
      return null;
    }
    if (lockOwner(aside) !== owner) {
      try {
        renameSync(aside, lock);
      } catch {}
      return null;
    }
    rmSync(aside, { recursive: true, force: true });
  }
  try {
    mkdirSync(lock);
  } catch (e) {
    if (e.code === "EEXIST") return null;
    throw e;
  }
  const token = `${process.pid}-${randomUUID()}`;
  writeFileSync(join(lock, "owner"), token);
  return () => {
    if (lockOwner(lock) === token) rmSync(lock, { recursive: true, force: true });
  };
}

/**
 * TM-485: the first `name` on PATH that is an executable file, from absolute PATH entries only, so
 * an empty or relative entry (".") cannot make the current directory supply `codex` or `grok`.
 * ponytail: PATH is still the operator's; pinning install locations per host would be stricter.
 */
export function trustedBin(name, path = process.env.PATH || "") {
  for (const dir of path.split(delimiter)) {
    if (!isAbsolute(dir)) continue;
    const file = join(dir, name);
    try {
      if (statSync(file).isFile()) {
        accessSync(file, constants.X_OK);
        return file;
      }
    } catch {}
  }
  return null;
}

/** The environment a host CLI is spawned with: what it needs to find its home and auth, no more. */
export function reducedEnv(env = process.env) {
  const keep = ["BYTEDESK_MARKETPLACE", "HOME", "PATH", "USER", "LOGNAME", "LANG", "LC_ALL", "TMPDIR", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_CACHE_HOME", "CODEX_HOME"];
  return Object.fromEntries(keep.filter((k) => env[k] !== undefined).map((k) => [k, env[k]]));
}

/** The body of a `[name]` TOML table. ponytail: regex, not a TOML parser. */
function tomlTable(toml, name) {
  const head = `^\\[${name.replace(/[.[\]]/g, "\\$&")}\\][^\\S\\n]*$`;
  return new RegExp(`${head}([\\s\\S]*?)(?=^\\[|(?![\\s\\S]))`, "m").exec(toml)?.[1] || "";
}
const tomlString = (table, key) => new RegExp(`^\\s*${key}\\s*=\\s*"([^"]*)"`, "m").exec(table)?.[1] ?? null;
const readText = (file) => {
  try {
    return readFileSync(file, "utf8");
  } catch {
    return "";
  }
};
const codexHomeOf = (home, env = process.env) => env.CODEX_HOME || join(home, ".codex");

/**
 * Where the Codex `bytedesk` marketplace really comes from, or null when it is not this one: a
 * local source must be this marketplace's own checkout; a git source must be ByteDeskAI's repo.
 * A plugin-rsync running from Codex's own bytedesk cache was installed from that marketplace, so
 * for it the registered local source is "this one" when it is a marketplace named bytedesk.
 * `local` is the checkout to compare content against, null for a git source.
 */
export function codexMarketplace(codexHome, here = marketplaceRoot(), self = ROOT) {
  const table = tomlTable(readText(join(codexHome, "config.toml")), "marketplaces.bytedesk");
  const type = tomlString(table, "source_type");
  const source = tomlString(table, "source");
  if (!source) return null;
  if (type === "local") {
    if (here && real(source) === real(here)) return { local: real(here) };
    const fromCodexCache = within(real(self), real(join(codexHome, "plugins", "cache", "bytedesk")));
    const named = readJson(join(source, ".claude-plugin", "marketplace.json"), null)?.name === "bytedesk";
    return fromCodexCache && named ? { local: real(source) } : null;
  }
  return /^(https:\/\/github\.com\/|ssh:\/\/git@github\.com\/|git@github\.com:)?ByteDeskAI\/bytedesk-marketplace(\.git)?\/?$/i.test(source) ? { local: null } : null;
}

const within = (path, root) => path.startsWith(root + sep);
const sameFile = (a, b) => {
  try {
    return readFileSync(a).equals(readFileSync(b));
  } catch {
    return false;
  }
};

/** Every regular file under `root` (outside node_modules and .git) matches `source`; a symlink fails. */
function sameTree(root, source) {
  try {
    for (const e of readdirSync(root, { recursive: true, withFileTypes: true })) {
      const f = join(e.parentPath, e.name);
      const rel = relative(root, f);
      if (rel.split(sep).some((p) => p === "node_modules" || p === ".git") || e.isDirectory()) continue;
      if (!e.isFile() || !sameFile(f, join(source, rel))) return false;
    }
    return true;
  } catch {
    return false;
  }
}

/**
 * TM-485: may plugin-rsync trust this Codex hook? Only an `untrusted` or `modified` hook of a
 * `<plugin>@bytedesk` plugin whose marketplace is this one (`market`), declared in that plugin's
 * Codex cache, whose command is a plain interpreter (or script) plus absolute paths inside that
 * same plugin root, with no shell syntax. A `modified` hook is trusted only when every file of its
 * cached plugin root is byte-identical to this marketplace's source (a hook script may source any
 * other file there), and the cache holds no file the source lacks.
 */
export function trustableHook(h, { codexHome, market }) {
  if (!market || h?.source !== "plugin" || !h.currentHash) return false;
  if (h.trustStatus !== "untrusted" && h.trustStatus !== "modified") return false;
  const name = /^([A-Za-z0-9][\w.-]*)@bytedesk$/.exec(h.pluginId || "")?.[1];
  if (!name || name === "." || name === "..") return false;
  const sources = market.local ? catalog(market.local).sources : null;
  if (sources && !sources[name]) return false;
  const cache = real(join(codexHome, "plugins", "cache", "bytedesk", name));
  const file = real(String(h.sourcePath || ""));
  if (!h.sourcePath || !within(file, cache)) return false;
  const root = join(cache, relative(cache, file).split(sep)[0]);
  const cmd = String(h.command || "");
  if (/[;&|<>`$\\\n\r]/.test(cmd)) return false;
  const tokens = [...cmd.matchAll(/"([^"]*)"|'([^']*)'|(\S+)/g)].map((t) => t[1] ?? t[2] ?? t[3]);
  const paths = tokens.filter((t) => t.includes("/"));
  if (!paths.length || !paths.every((t) => isAbsolute(t) && within(real(t), root))) return false;
  if (!paths.includes(tokens[0]) && !["node", "bash", "sh"].includes(tokens[0])) return false;
  if (h.trustStatus === "modified") {
    if (!sources) return false;
    return sameTree(root, sources[name]);
  }
  return true;
}

/**
 * Codex runs a plugin hook only once its hash is trusted in ~/.codex/config.toml, and asks for that
 * trust in its TUI. Ask Codex's own app-server which bytedesk plugin hooks are untrusted and write
 * their current hashes back through its config API, so a synced hook runs in the next session.
 * Only `<plugin>@bytedesk` hooks are touched: this marketplace is the operator's own code.
 * ponytail: speaks app-server JSON-RPC by hand; a codex CLI verb for hook trust would replace it.
 */
function trustCodexHooks({ cwd = ROOT, timeoutMs = 20000, home = HOME } = {}) {
  const codexHome = codexHomeOf(home);
  const market = codexMarketplace(codexHome);
  if (!market) return Promise.resolve({ ok: false, foreign: true, err: "the Codex bytedesk marketplace is not this marketplace" });
  const codex = trustedBin("codex");
  if (!codex) return Promise.resolve({ ok: false, err: "codex is not on PATH" });
  // One run at a time. The app-server this spawns may start plugin MCP servers, including ours,
  // which would start another run: the lock ends that chain. A lock older than any run is stale.
  let unlock;
  try {
    unlock = acquireLock(join(codexHome, ".plugin-rsync-trust.lock"), 2 * 60 * 1000);
  } catch (e) {
    return Promise.resolve({ ok: false, err: `lock: ${e.code || e.message}` });
  }
  if (!unlock) return Promise.resolve({ ok: true, trusted: [], busy: true });
  return new Promise((done) => {
    let child;
    try {
      child = spawn(codex, ["app-server"], { cwd, env: reducedEnv(), stdio: ["pipe", "pipe", "ignore"] });
    } catch {
      unlock();
      return done({ ok: false, err: "codex not runnable" });
    }
    let settled = false;
    const finish = (r) => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      child.kill();
      unlock();
      done(r);
    };
    const timer = setTimeout(() => finish({ ok: false, err: "codex app-server timed out" }), timeoutMs);
    child.on("error", () => finish({ ok: false, err: "codex is not on PATH" }));
    child.stdin.on("error", () => finish({ ok: false, err: "codex app-server closed its input" }));
    child.on("exit", (code) => finish({ ok: false, err: `codex app-server exited ${code} before answering` }));
    const send = (m) => child.stdin.write(`${JSON.stringify({ jsonrpc: "2.0", ...m })}\n`);
    let trusted = [];
    createInterface({ input: child.stdout }).on("line", (line) => {
      let m;
      try {
        m = JSON.parse(line);
      } catch {
        return;
      }
      if (m.id === 1) {
        send({ method: "initialized" });
        send({ id: 2, method: "hooks/list", params: { cwds: [cwd] } });
      } else if (m.id === 2) {
        if (m.error) return finish({ ok: false, err: m.error.message });
        const state = {};
        for (const h of (m.result?.data || []).flatMap((d) => d.hooks || [])) {
          if (trustableHook(h, { codexHome, market })) state[h.key] = { trusted_hash: h.currentHash };
        }
        trusted = Object.keys(state);
        if (!trusted.length) return finish({ ok: true, trusted });
        send({ id: 3, method: "config/batchWrite", params: { edits: [{ keyPath: "hooks.state", value: state, mergeStrategy: "upsert" }] } });
      } else if (m.id === 3) {
        finish(m.error ? { ok: false, err: m.error.message } : { ok: true, trusted });
      }
    });
    send({ id: 1, method: "initialize", params: { clientInfo: { name: "plugin-rsync", version: "0" } } });
  });
}

/**
 * A Grok install whose Local source is a whole marketplace (not one plugin folder) is re-copied on
 * every Grok start — worktrees and all, tens of GB here — and Grok gives up loading plugins, so no
 * hook runs. Reinstall each such plugin from `<marketplace>/<plugin>`. No-op when none match.
 * One run at a time (a lock dir), because every session start calls this.
 * TM-485: only the bytedesk marketplace (the operator's own code) is touched, and only an entry
 * that was trusted is reinstalled with --trust. This Grok replaced trust with enable/disable and
 * keeps no trust flag in the registry, so a `trusted: false` entry or one in `[plugins].disabled`
 * counts as untrusted: it is reported and left as it is, never re-trusted.
 */
/** Plugin names/IDs in ~/.grok/config.toml `[plugins].disabled`. */
function grokDisabled(home) {
  const toml = readText(join(home, ".grok", "config.toml"));
  const list = /^\s*disabled\s*=\s*\[([^\]]*)\]/m.exec(tomlTable(toml, "plugins"))?.[1] || "";
  return [...list.matchAll(/"([^"]*)"|'([^']*)'/g)].map((m) => m[1] ?? m[2]);
}

function fixGrokInstalls({ home = HOME } = {}) {
  const reg = readJson(join(home, ".grok", "installed-plugins", "registry.json"), null);
  const disabled = grokDisabled(home);
  const bad = [];
  const untrusted = [];
  for (const entry of Object.values(reg?.repos || {})) {
    const src = entry?.kind?.type === "Local" ? entry.kind.source_path : null;
    if (!src || readJson(join(src, ".claude-plugin", "marketplace.json"), null)?.name !== "bytedesk") continue;
    for (const [name, meta] of Object.entries(entry.plugins || {})) {
      const dir = resolve(src, meta?.subdir || name);
      if (!isDir(dir)) continue;
      if (entry.trusted === false || meta?.trusted === false || disabled.some((id) => id === name || id.endsWith(`/${name}`))) untrusted.push(name);
      else bad.push({ name, src: dir, original: `${src}#${meta?.subdir || name}` });
    }
  }
  if (!bad.length) return { ok: true, fixed: [], untrusted };
  const bin = trustedBin("grok");
  if (!bin) return { ok: false, fixed: [], untrusted, err: "grok is not on PATH" };
  // A run killed mid-way leaves its lock; one older than any run could take is reclaimed, or the
  // repair would be skipped forever.
  let unlock;
  try {
    unlock = acquireLock(join(home, ".grok", ".plugin-rsync-fix.lock"), 15 * 60 * 1000);
  } catch (e) {
    return { ok: false, fixed: [], untrusted, err: `lock: ${e.code || e.message}` };
  }
  if (!unlock) return { ok: true, fixed: [], untrusted, busy: true };
  try {
    const fixed = [];
    const grok = (...args) => spawnSync(bin, ["plugin", ...args], { cwd: ROOT, env: reducedEnv(), encoding: "utf8", timeout: 300000 });
    for (const { name, src, original } of bad) {
      const un = grok("uninstall", name);
      if (un.error) return { ok: false, fixed, untrusted, err: `grok: ${un.error.code || un.error.message}` };
      // A failed uninstall leaves the old install in place: installing over it would only fail too.
      if (un.status !== 0) return { ok: false, fixed, untrusted, err: `grok plugin uninstall ${name} exited ${un.status}: ${(un.stderr || un.stdout || "").trim()}; left as it was` };
      const inst = grok("install", "--trust", src);
      if (inst.status !== 0) {
        // Put the old install back rather than leave the plugin missing.
        const back = grok("install", "--trust", original);
        return { ok: false, fixed, untrusted, err: `grok plugin install ${src}: ${(inst.stderr || inst.stdout || "").trim()}; restored ${original}: ${back.status === 0 ? "ok" : "FAILED"}` };
      }
      fixed.push(name);
    }
    return { ok: true, fixed, untrusted };
  } finally {
    unlock();
  }
}

function help() {
  return `plugin-rsync — refresh installed ByteDesk marketplace plugin caches from source.

  plugin-rsync                         every installed bytedesk plugin
  plugin-rsync task-management         one plugin
  plugin-rsync task-management,fleet   several (comma-separated; spaces also work)

  --list        print destinations, do not copy
  --dry-run     print rsync argv, do not copy
  --json        machine-readable report (with --dry-run: rsync -n, so it previews
                what would change and copies nothing). Report only; never reloads.
  install-cli   wrapper in ~/.local/bin (user-scope; never a project)
  trust-codex-hooks  trust every untrusted <plugin>@bytedesk hook in Codex (also run after each Codex sync)
  fix-grok-installs  reinstall Grok plugins sourced from a whole marketplace from their own folder

User-scope only. Do not add plugin-rsync@bytedesk to a repo's extraKnownMarketplaces.

Source: BYTEDESK_MARKETPLACE, or the marketplace next to this plugin, or the
directory-source bytedesk marketplace in ~/.claude/plugins/known_marketplaces.json.

--json classifies each changed path (plugin-relative) by what a running session needs:
  needs-reload  hooks/ skills/ commands/ agents/ monitors/, manifests
                (.claude-plugin/ .codex-plugin/ .grok-plugin/), .mcp.json, .codex-mcp.json,
                every file a long-running process starts from: the MCP server entry those
                name (e.g. bin/tm-mcp) and each monitor command in monitors/monitors.json
                (e.g. bin/tm-dashboard, bin/claude-sessions), and lib/ src/ dist/ when the
                plugin declares an MCP server or a monitor (loaded once at process start)
  live          everything else: bin/ CLIs that are not a server or monitor entry, and
                code that only they load, run fresh per call
  skipped       a host (claude, grok, codex) with no install of that plugin
reloads_required lists, per host, the plugins with at least one needs-reload path.
`;
}

function installCli() {
  const destDir = join(HOME, ".local", "bin");
  const target = join(destDir, "plugin-rsync");
  if (existsSync(target) && !readFileSync(target, "utf8").includes(SENTINEL)) {
    return { state: "foreign", target };
  }
  const script = `#!/usr/bin/env bash
${SENTINEL}
# Auto-generated by plugin-rsync install-cli. User-scope PATH wrapper.
src="${ROOT}/bin/plugin-rsync"
if [ -x "$src" ]; then exec node "$src" "$@"; fi
latest="$(ls -dt "$HOME"/.claude/plugins/cache/bytedesk/plugin-rsync/*/bin/plugin-rsync 2>/dev/null | head -1)"
if [ -n "$latest" ] && [ -x "$latest" ]; then exec node "$latest" "$@"; fi
echo "plugin-rsync: no installed copy found. Re-run install-cli after installing plugin-rsync@bytedesk (user scope)." >&2
exit 127
`;
  mkdirSync(destDir, { recursive: true });
  const existed = existsSync(target);
  writeFileSync(target, script, { mode: 0o755 });
  return {
    state: existed ? "refreshed" : "created",
    target,
    onPath: (process.env.PATH || "").split(":").includes(destDir),
  };
}

async function main(argv) {
  if (argv.includes("-h") || argv.includes("--help")) {
    process.stdout.write(help());
    return 0;
  }
  if (argv[0] === "install-cli") {
    const r = installCli();
    if (r.state === "foreign") {
      console.error(`plugin-rsync: ${pretty(r.target)} exists and is not our wrapper — not overwriting`);
      return 2;
    }
    console.log(`${r.state}: ${pretty(r.target)}`);
    if (!r.onPath) console.log("note: ~/.local/bin is not on PATH");
    return 0;
  }

  if (argv[0] === "fix-grok-installs") {
    const r = fixGrokInstalls();
    console.log(r.ok ? `grok installs fixed: ${r.fixed.length ? r.fixed.join(", ") : r.busy ? "another run is fixing them" : "none needed"}` : `grok install fix failed: ${r.err}`);
    if (r.untrusted?.length) console.log(`grok installs left as they are (not trusted, not re-trusted): ${r.untrusted.join(", ")}`);
    return r.ok ? 0 : 1;
  }
  if (argv[0] === "trust-codex-hooks") {
    const r = await trustCodexHooks();
    console.log(r.ok ? `codex hooks trusted: ${r.trusted.length ? r.trusted.join(", ") : r.busy ? "another run is trusting them" : "none needed"}` : `codex hook trust skipped: ${r.err}`);
    return r.ok ? 0 : 1;
  }

  const dry = argv.includes("--dry-run");
  if (argv.includes("--json")) return mainJson(argv, dry);
  const listOnly = argv.includes("--list");
  const wanted = parseNames(argv);
  const market = marketplaceRoot();
  if (!market) {
    console.error("plugin-rsync: cannot find the bytedesk marketplace source (set BYTEDESK_MARKETPLACE)");
    return 2;
  }
  const { names, sources } = catalog(market);
  const selected = wanted.length ? wanted : names;
  const unknown = selected.filter((n) => !names.includes(n));
  if (unknown.length) {
    console.error(`plugin-rsync: not in the marketplace: ${unknown.join(", ")}`);
    return 2;
  }

  const dests = installedDests(names);
  const srcReal = real(market);
  let copies = 0;
  let missing = 0;
  let failed = 0;
  let codexSynced = false;

  for (const name of selected) {
    const src = sources[name];
    const rows = (dests.get(name) || []).filter((d) => d.real !== real(src) && d.real !== srcReal);
    if (!rows.length) {
      console.log(`${name}: not installed`);
      missing += 1;
      continue;
    }
    console.log(name);
    for (const row of rows) {
      if (listOnly) {
        console.log(`  ${row.host.padEnd(6)} ${pretty(row.dest)}`);
        continue;
      }
      const result = runRsync(src, row.dest, dry);
      if (result.dry) {
        console.log(`  ${row.host.padEnd(6)} ${pretty(row.dest)}`);
        console.log(`         rsync ${result.args.join(" ")}`);
        copies += 1;
        continue;
      }
      if (!result.ok) {
        console.log(`  ${row.host.padEnd(6)} ${pretty(row.dest)}  FAIL ${result.err}`);
        failed += 1;
        continue;
      }
      console.log(`  ${row.host.padEnd(6)} ${pretty(row.dest)}  ok`);
      copies += 1;
      if (row.host === "codex") codexSynced = true;
    }
  }

  if (listOnly) return 0;
  if (codexSynced) {
    const r = await trustCodexHooks();
    // A sync from a checkout Codex does not install from (a worktree) has nothing to trust: quiet.
    if (!r.ok && !r.foreign) console.log(`codex hook trust skipped: ${r.err}`);
    else if (r.ok && r.trusted.length) console.log(`codex hooks trusted: ${r.trusted.join(", ")}`);
  }
  if (wanted.length && copies === 0 && failed === 0) return 2;
  return failed ? 1 : 0;
}

function mainJson(argv, dry) {
  const listOnly = argv.includes("--list");
  const wanted = parseNames(argv);
  const fail = (error) => {
    process.stdout.write(`${JSON.stringify({ ok: false, error }, null, 2)}\n`);
    return 2;
  };
  const market = marketplaceRoot();
  if (!market) return fail("cannot find the bytedesk marketplace source (set BYTEDESK_MARKETPLACE)");
  const { names, sources } = catalog(market);
  const selected = wanted.length ? wanted : names;
  const unknown = selected.filter((n) => !names.includes(n));
  if (unknown.length) return fail(`not in the marketplace: ${unknown.join(", ")}`);

  const dests = installedDests(names);
  const srcReal = real(market);
  const reloads = Object.fromEntries(HOSTS.map((h) => [h, []]));
  const plugins = [];
  let copies = 0;
  let failed = 0;

  for (const name of selected) {
    const src = sources[name];
    const procs = processEntries(src);
    const rows = (dests.get(name) || []).filter((d) => d.real !== real(src) && d.real !== srcReal);
    const caches = [];
    for (const row of rows) {
      const cache = { host: row.host, path: row.dest, status: "ok", changed: false, paths: [] };
      caches.push(cache);
      if (listOnly) {
        cache.status = "listed";
        cache.changed = null;
        continue;
      }
      const r = runRsync(src, row.dest, false, dry ? ["-i", "-n"] : ["-i"]);
      if (!r.ok) {
        Object.assign(cache, { status: "failed", changed: null, error: r.err });
        failed += 1;
        continue;
      }
      if (dry) cache.status = "dry-run";
      copies += 1;
      cache.paths = parseItemized(r.stdout).map((p) => ({ ...p, class: classify(p.path, procs) }));
      cache.changed = cache.paths.length > 0;
      if (cache.paths.some((p) => p.class === "needs-reload") && !reloads[row.host].includes(name)) {
        reloads[row.host].push(name);
      }
    }
    for (const host of HOSTS) {
      if (!caches.some((c) => c.host === host)) {
        caches.push({ host, path: null, status: "skipped", changed: false, paths: [], reason: "host not installed" });
      }
    }
    plugins.push({ name, source: src, installed: rows.length > 0, caches });
  }

  const exit = listOnly ? 0 : wanted.length && copies === 0 && failed === 0 ? 2 : failed ? 1 : 0;
  const report = { ok: exit === 0, dry_run: dry, list_only: listOnly, marketplace: market, plugins, reloads_required: reloads };
  process.stdout.write(`${JSON.stringify(report, null, 2)}\n`);
  return exit;
}

const isMain = process.argv[1] && real(process.argv[1]) === real(fileURLToPath(import.meta.url));
if (isMain) main(process.argv.slice(2)).then((code) => process.exit(code));
