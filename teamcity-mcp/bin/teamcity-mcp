#!/bin/sh
# teamcity-mcp launcher: runs the bundled server, (re)building it when missing or stale.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BUNDLE="$ROOT/dist/bundle.cjs"

# Credentials/config: MCP hosts spawn us with a bare environment, so load the
# user-level env file (override with TEAMCITY_MCP_ENV).
ENV_FILE="${TEAMCITY_MCP_ENV:-$HOME/.config/teamcity-mcp/env}"
if [ -f "$ENV_FILE" ]; then
  set -a
  . "$ENV_FILE"
  set +a
fi

needs_build=0
[ -f "$BUNDLE" ] || needs_build=1
# Rebuild when any source file is newer than the bundle (covers git pull / local edits).
if [ "$needs_build" -eq 0 ] && [ -n "$(find "$ROOT/src" -name '*.ts' -newer "$BUNDLE" -print -quit 2>/dev/null)" ]; then
  needs_build=1
fi

if [ "$needs_build" -eq 1 ]; then
  cd "$ROOT"
  if [ ! -d node_modules ] || [ "$ROOT/package-lock.json" -nt "$ROOT/node_modules" ]; then
    echo "teamcity-mcp: installing dependencies..." >&2
    npm ci --no-audit --no-fund >&2
  fi
  echo "teamcity-mcp: building bundle..." >&2
  npm run bundle >&2
fi

# Plugin/Desktop/npx contexts expect stdio by default; service use sets
# MCP_TRANSPORT=http (or passes an explicit flag).
if [ "$#" -eq 0 ] && [ -z "${MCP_TRANSPORT:-}" ]; then
  set -- --stdio
fi

exec node "$BUNDLE" "$@"
