# --- TeamCity connection (required) ---
TEAMCITY_URL=https://deploy.prod.bytedesk.ai

# Preferred: personal access token (TeamCity -> Profile -> Access Tokens)
TEAMCITY_TOKEN=

# Alternative: basic auth (uses the /httpAuth prefix)
# TEAMCITY_USERNAME=
# TEAMCITY_PASSWORD=

# --- MCP server ---
# Port and bind address. Defaults to loopback only.
PORT=3000
HOST=127.0.0.1

# full (default): all tools incl. writes. read: read-only tools + GET passthrough only.
TEAMCITY_MCP_MODE=full

# Protect the MCP endpoint itself with a static bearer token.
# Required automatically when HOST is not loopback.
# MCP_AUTH_TOKEN=

# Stateless mode: no MCP sessions, each request independent (scales horizontally).
# MCP_STATELESS=false

# Gateway mode (opt-in, off by default): forward the MCP client's bearer token
# to TeamCity instead of using server-configured credentials.
# TEAMCITY_PER_REQUEST_AUTH=false
